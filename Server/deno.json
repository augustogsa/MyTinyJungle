{
  "imports": {
    "hono": "npm:hono@4.13.13",
    "hono/": "npm:/hono@4.13.13/",
    "zod": "npm:zod@4.6.7",
    "jose": "npm:jose@6.1.0",
    "pg": "npm:pg@8.23.0"
  },
  "nodeModulesDir": "none",
  "compilerOptions": {
    "strict": true
  },
  "tasks": {
    "check": "deno check main.ts tools/migrate.ts tools/admin_token.ts",
    "test": "deno test --allow-env tests",
    "serve": "deno run --allow-env --allow-net --allow-read main.ts",
    "migrate": "deno run --allow-env --allow-net --allow-read tools/migrate.ts",
    "admin-token": "deno run --allow-env --allow-net --allow-read tools/admin_token.ts"
  },
  "fmt": {
    "lineWidth": 120
  }
}