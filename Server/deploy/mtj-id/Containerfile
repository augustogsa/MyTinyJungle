FROM docker.io/library/python:3.12-slim
# CPU wheels only (torch and torchvision both from the CPU index, or pip drags in 3 GB of CUDA libraries).
RUN pip install --no-cache-dir torch==2.5.1+cpu torchvision==0.20.1+cpu --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir open_clip_torch==2.29.0 pillow==11.0.0 numpy==2.1.3
ENV HF_HOME=/models/hf
COPY server.py /srv/server.py
CMD ["python", "/srv/server.py"]
