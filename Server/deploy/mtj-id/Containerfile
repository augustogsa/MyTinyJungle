FROM docker.io/library/python:3.12-slim
# No torch: BioCLIP runs on onnxruntime (int8 image encoder). Models and the reference index live in /refs.
RUN pip install --no-cache-dir onnxruntime==1.20.1 numpy==2.1.3 pillow==11.0.0 ftfy==6.3.1 regex==2024.11.6
COPY server.py clipnx.py cliptok.py bpe_simple_vocab_16e6.txt.gz /srv/
WORKDIR /srv
CMD ["python", "/srv/server.py"]
