[Unit]
OnFailure=mtj-alert@%n.service
Description=My Tiny Jungle purge (accounts deleted 30+ days ago, expired sessions)

[Service]
Type=oneshot
User=mtj-api
EnvironmentFile=/opt/mtj/secrets/owner.env
Environment=MTJ_MEDIA_DIR=/var/lib/mtj/media
ExecStart=/opt/mtj/bin/mtj-api purge
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/mtj/media
