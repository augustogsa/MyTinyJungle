[Unit]
OnFailure=mtj-alert@%n.service
Description=My Tiny Jungle API (Go, unix socket behind Apache + Cloudflare)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mtj-api
# Primary group nobody = Apache, so the socket (0660) is reachable only by Apache; mtj-api group reads secrets.
Group=nobody
SupplementaryGroups=mtj-api
EnvironmentFile=/opt/mtj/secrets/api.env
ExecStart=/opt/mtj/bin/mtj-api serve
Restart=always
RestartSec=2
RuntimeDirectory=mtj
RuntimeDirectoryMode=0750
UMask=0077
LimitNOFILE=65536
MemoryMax=512M
TasksMax=256

# Sandbox
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/mtj/media
ReadOnlyPaths=/opt/mtj

[Install]
WantedBy=multi-user.target
