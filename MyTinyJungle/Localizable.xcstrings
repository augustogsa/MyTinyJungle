            "value" : "Sobald eine Rispe erscheint, die Pflanze nicht umstellen oder drehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cuanto salga una vara, no muevas ni gires la planta."
