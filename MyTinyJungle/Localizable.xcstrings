        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que drene rápido no significa que necesite maceta nueva. Échales un ojo a las raíces en un mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un drainage rapide ne veut pas dire qu'il faut un nouveau pot. Jette un œil aux racines dans un mois."
