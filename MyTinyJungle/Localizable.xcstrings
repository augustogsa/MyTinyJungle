    "Old lower leaves yellow naturally. On new leaves, check light and food." : {
      "comment" : "Photo diagnosis advice.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alte, untere Blätter werden natürlich gelb. Bei neuen Blättern Licht und Futter prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las hojas viejas de abajo se ponen amarillas de forma natural. Si son hojas nuevas, revisa la luz y la comida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vieilles feuilles du bas jaunissent naturellement. Sur les nouvelles, vérifie la lumière et l'engrais."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古い下葉が黄色くなるのは自然なこと。新しい葉なら、光と肥料をチェックしてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folhas velhas de baixo amarelam naturalmente. Se for nas novas, confira a luz e o adubo."
          }
        }
      }
    },
