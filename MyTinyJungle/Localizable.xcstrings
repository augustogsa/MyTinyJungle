    "chunky aroid mix (bark, perlite, coco coir)" : {
      "comment" : "Soil mix name, lowercase, used inside a sentence",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "grobe Aroiden-Erde (Rinde, Perlite, Kokosfaser)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mezcla gruesa para aráceas (corteza, perlita, fibra de coco)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mélange grossier pour aracées (écorce, perlite, fibre de coco)"
          }
        },
        "ja" : {
