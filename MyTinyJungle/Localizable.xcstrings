    "Wipe dust off leaves to catch more light": {
      "comment": "Seasonal plant care to-do; short imperative",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire a poeira das folhas pra pegarem mais luz"
          }
        }
      }
    },
    "Wipe from stem to tip, top and underside. Check for pests while you're there.": {
      "comment": "Care guide step instruction; warm, practical",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe do caule até a ponta, em cima e embaixo. Aproveite para procurar pragas."
          }
        }
      }
    },
    "Wipe gently": {
      "comment": "Care guide step title; short",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe com carinho"
          }
        }
      }
    },
    "Wipe scissors with alcohol so you don't spread disease.": {
      "comment": "Care guide step instruction; warm, practical",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe álcool na tesoura para não espalhar doenças."
          }
        }
      }
    },
    "Wipe the blades with alcohol between cuts.": {
      "comment": "Care guide step tip",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe álcool nas lâminas entre um corte e outro."
          }
        }
      }
    },
    "Wipe with alcohol on a cotton pad": {
      "comment": "Pest treatment step; imperative, short; max 70 chars",
