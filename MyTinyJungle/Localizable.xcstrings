    "Radiators and heaters dry the air. Keep pots a metre away." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heizkörper und Heizlüfter trocknen die Luft. Halte Töpfe einen Meter weg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los calefactores y radiadores resecan el aire. Deja las macetas a un metro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les radiateurs et chauffages assèchent l'air. Garde les pots à un mètre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暖房器具やヒーターは空気を乾燥させます。鉢は1mは離してね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquecedores e ar-condicionado ressecam o ar. Deixe os vasos a um metro de distância."
          }
        }
      }
    },
    "Rain washes nutrients out. A liquid feed every 1–2 weeks keeps flowers coming." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regen wäscht Nährstoffe aus. Flüssigdünger alle 1–2 Wochen hält die Blüten am Kommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lluvia se lleva los nutrientes. Un abono líquido cada 1–2 semanas mantiene las flores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pluie lessive les nutriments. Un engrais liquide toutes les 1 à 2 semaines, et les fleurs continuent d'arriver."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨で栄養が流れてしまいます。1〜2週間ごとに液体肥料をあげると、花が咲き続けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chuva leva os nutrientes embora. Adubo líquido a cada 1–2 semanas garante flores sem parar."
          }
        }
      }
    },
    "Rainwater" : {
      "comment" : "Care guide step title; short",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regenwasser"
          }
        },
        "es" : {
