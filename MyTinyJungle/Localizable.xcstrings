          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたを待っている子たち：\n%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem precisa de você:\n%@"
          }
        }
      }
    },
    "Hey, it's me. Haven't seen you in a few days. How does my soil feel?" : {
      "comment" : "Plant speaks up on its own in chat: nobody checked in a while. Friendly, first person.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey, ich bin’s. Hab dich ein paar Tage nicht gesehen. Wie fühlt sich meine Erde an?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola, soy yo. Hace unos días que no te veo. ¿Cómo sientes mi tierra?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou, c'est moi. Je ne t'ai pas vu depuis quelques jours. Elle est comment, ma terre ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やあ、ぼくだよ。何日か会ってないね。土の具合はどう？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi, sou eu! Faz uns dias que não te vejo. Como tá minha terra?"
          }
        }
      }
    },
    "Hey, it's me. I haven't seen you in a few days. How does my soil feel?" : {
      "comment" : "Demo chat notification body, plant missing its owner",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey, ich bin’s. Ich hab dich ein paar Tage nicht gesehen. Wie fühlt sich meine Erde an?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola, soy yo. Hace unos días que no te veo. ¿Cómo sientes mi tierra?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou, c'est moi. Ça fait quelques jours que je ne t'ai pas vu. Elle est comment, ma terre ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やあ、ぼくだよ。何日か会ってないね。ぼくの土の具合はどう？"
          }
