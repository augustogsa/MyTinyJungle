    "Pause feeding from mid-autumn to early spring. Resting plants can't use it and the salts pile up." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz das Düngen von Mitte Herbst bis Anfang Frühling aus. Ruhende Pflanzen können es nicht nutzen und die Salze sammeln sich an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa el abono de mediados de otoño a principios de primavera. Las plantas en reposo no lo aprovechan y las sales se acumulan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais une pause dans l'engrais de la mi-automne au début du printemps. Les plantes au repos ne peuvent pas l'utiliser et le sel s'accumule."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "秋の半ばから早春までは肥料をお休み。休んでいる植物は使えず、塩分がたまるだけです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pare de adubar do meio do outono até o início da primavera. Planta em repouso não aproveita, e os sais se acumulam."
          }
        }
      }
    },
    "Pause feeding until spring" : {
      "comment" : "Seasonal plant care to-do; short imperative",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düngen bis zum Frühling pausieren"
