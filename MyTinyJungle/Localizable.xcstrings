    "Repot into fresh, chunkier mix in a pot with drainage holes, only as big as the root ball." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topf sie in frische, gröbere Erde in einen Topf mit Abzugslöchern um, nur so groß wie der Wurzelballen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasplanta a una mezcla nueva y más gruesa en una maceta con agujeros de drenaje, solo del tamaño del cepellón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rempote dans un mélange frais plus grossier, dans un pot avec trous de drainage, juste à la taille de la motte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水抜き穴のある鉢に、新しい粗めの土で植え替えます。鉢は根鉢と同じくらいの大きさで。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troque de vaso com substrato novo e mais aerado, num vaso com furos e só um pouco maior que o torrão."
          }
        }
      }
    },
    "Repot me when roots come out of the drainage holes, circle the pot, or water runs straight through." : {
      "comment" : "Plant chat: signs it's time to repot.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topf mich um, wenn Wurzeln aus den Abzugslöchern kommen, im Topf kreisen oder Wasser einfach durchläuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasplántame cuando salgan raíces por los agujeros, den vueltas en la maceta o el agua pase directo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rempote-moi quand les racines sortent des trous de drainage, tournent dans le pot, ou quand l'eau passe tout droit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根っこが鉢底の穴から出てきたり、鉢の中でぐるぐる回ったり、水がすぐ素通りするようになったら植え替えてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troca meu vaso quando as raízes saírem pelos furos, derem voltas no vaso ou a água passar direto."
          }
        }
      }
    },
