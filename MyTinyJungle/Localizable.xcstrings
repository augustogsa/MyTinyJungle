    "Shelves and hanging pots keep curious mouths away from the rest." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regale und Hängetöpfe halten neugierige Mäuler von allem anderen fern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las repisas y macetas colgantes alejan a las boquitas curiosas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les étagères et suspensions gardent les petites bouches curieuses loin du reste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "棚や吊り鉢なら、好奇心旺盛な口からほかの植物を守れます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prateleiras e vasos suspensos deixam as bocas curiosas longe do resto."
          }
        }
      }
    },
    "Shift plants nearer to windows, but not touching cold glass." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rück Pflanzen näher ans Fenster, aber nicht ans kalte Glas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca las plantas a las ventanas, pero sin tocar el vidrio frío."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapproche les plantes des fenêtres, sans qu'elles touchent la vitre froide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "植物を窓に近づけて。ただし冷たいガラスにはふれないように。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aproxime as plantas das janelas, mas sem encostar no vidro frio."
          }
        }
      }
