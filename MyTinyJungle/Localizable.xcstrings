    "Drink time! My soil is dry." : {
      "comment" : "Plant speaking in chat, request water, default voice (cheerful/any personality): warm and friendly.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinkzeit! Meine Erde ist trocken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hora de tomar agua! Mi tierra está seca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À boire ! Ma terre est sèche."
          }
        },
        "ja" : {
          "stringUnit" : {
