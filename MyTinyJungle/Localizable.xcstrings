    "A clean knife through tight roots is fine. Each piece needs leaves and roots." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein sauberes Messer durch dichte Wurzeln ist okay. Jedes Stück braucht Blätter und Wurzeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cortar raíces apretadas con un cuchillo limpio está bien. Cada pedazo necesita hojas y raíces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un coup de couteau propre dans des racines serrées, ça passe. Chaque morceau doit avoir des feuilles et des racines."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根がぎゅうぎゅうなら、清潔なナイフで切っても大丈夫。それぞれに葉と根が残るようにしてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo bem usar uma faca limpa nas raízes apertadas. Cada pedaço precisa ter folhas e raízes."
          }
        }
      }
    },
    "A cold night is coming. Please bring %@ inside or wrap it in fleece before bed." : {
      "comment" : "Notification body; %@ plant name; frost warning",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute Nacht wird’s kalt. Hol %@ bitte vor dem Schlafen rein oder pack sie in Vlies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene una noche fría. Mete a %@ o envuélvela en una mantita antes de dormir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nuit froide arrive. Rentre %@ ou emmitoufle-la dans un voile d'hivernage avant d'aller dormir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜は冷え込みそう。寝る前に%@を室内に入れるか、不織布でくるんであげてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vem uma noite fria por aí. Leve %@ pra dentro ou cubra com um pano antes de dormir."
          }
        }
      }
    },
