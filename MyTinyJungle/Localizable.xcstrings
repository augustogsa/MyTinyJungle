    "A new plant": {
      "comment": "Scan mode tile title",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma planta nova"
          }
        }
      }
    },
    "A node is the small bump where a leaf meets the stem. New growth starts there.": {
      "comment": "Care guide step instruction; warm, practical",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nó é o calombinho onde a folha encontra o caule. É ali que nasce o crescimento novo."
          }
        }
      }
    },
    "A pet-friendly jungle": {
      "comment": "Care guide title; short",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma selva amiga dos pets"
          }
        }
      }
    },
    "A plant is thinking of you": {
      "comment": "Notification body when previews hidden",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma plantinha está pensando em você"
