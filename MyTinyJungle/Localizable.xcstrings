    "%@ like it warmer than that. A sheltered corner or a night indoors will keep them cosy." : {
      "comment" : "Weather alert detail. %@ = plant names list (plural subject).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mögen es wärmer. Eine geschützte Ecke oder eine Nacht drinnen hält sie mollig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ les gusta más calientito. Un rincón protegido o una noche adentro las mantendrá a gusto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aiment avoir plus chaud que ça. Un coin abrité ou une nuit à l'intérieur les gardera bien au chaud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はもっと暖かいほうが好き。風の当たらない場所か、夜だけ室内に入れてあげると安心です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gostam de mais calor. Um cantinho protegido ou uma noite dentro de casa resolve."
          }
        }
      }
    },
    "%@ likes %lld%%+ humidity. Group plants or use a humidifier." : {
      "comment" : "Photo diagnosis advice. Args: plant common name, minimum humidity percent.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
