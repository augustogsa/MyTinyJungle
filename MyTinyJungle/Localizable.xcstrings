    "Choose a pot just 2–5 cm wider. Too much soil stays wet and roots rot." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm einen Topf, der nur 2–5 cm breiter ist. Zu viel Erde bleibt nass und die Wurzeln faulen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una maceta solo 2–5 cm más ancha. Demasiada tierra se queda mojada y las raíces se pudren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis un pot juste 2 à 5 cm plus large. Trop de terre reste humide et les racines pourrissent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今より直径2〜5cmだけ大きい鉢を選んでね。土が多すぎると湿ったままになって根腐れします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um vaso só 2–5 cm mais largo. Terra demais fica encharcada e a raiz apodrece."
          }
        }
      }
    },
