    "In summer about every %lld–%lld days, in winter about every %lld–%lld days. Always feel the soil first." : {
      "comment" : "Seasonal watering advice; summer and winter day ranges",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Sommer etwa alle %1$lld–%2$lld Tage, im Winter etwa alle %3$lld–%4$lld Tage. Fühl immer erst die Erde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In summer about every %1$lld–%2$lld days, in winter about every %3$lld–%4$lld days. Always feel the soil first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En verano más o menos cada %1$lld–%2$lld días, en invierno cada %3$lld–%4$lld días. Siempre toca la tierra primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En été, environ tous les %1$lld à %2$lld jours, en hiver tous les %3$lld à %4$lld jours. Tâte toujours la terre d'abord."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夏はだいたい%1$lld〜%2$lld日ごと、冬はだいたい%3$lld〜%4$lld日ごと。まずは土をさわってみてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No verão, a cada %1$lld–%2$lld dias; no inverno, a cada %3$lld–%4$lld dias. Sempre sinta a terra antes."
          }
        }
      }
    },
    "In summer about every %lld–%lld days, in winter barely at all, a sip once a month. Always feel the soil first." : {
      "comment" : "Seasonal watering advice; summer day range",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Sommer etwa alle %1$lld–%2$lld Tage, im Winter kaum, ein Schlückchen im Monat. Fühl immer erst die Erde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In summer about every %1$lld–%2$lld days, in winter barely at all, a sip once a month. Always feel the soil first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En verano más o menos cada %1$lld–%2$lld días, en invierno casi nada, un sorbito al mes. Siempre toca la tierra primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En été, environ tous les %1$lld à %2$lld jours, en hiver presque pas, une gorgée par mois. Tâte toujours la terre d'abord."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夏はだいたい%1$lld〜%2$lld日ごと、冬はほぼいらなくて、月に1回ちょっぴり。まずは土をさわってみてね。"
