    "Short days slow growth, so soil stays wet much longer. Always feel before watering." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurze Tage bremsen das Wachstum, die Erde bleibt viel länger nass. Vor dem Gießen immer fühlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días cortos frenan el crecimiento, así que la tierra se queda mojada mucho más tiempo. Siempre tócala antes de regar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours courts ralentissent la pousse, la terre reste humide bien plus longtemps. Tâte toujours avant d'arroser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日が短いと成長がゆっくりになり、土がずっと長く湿ったままに。水やり前は必ず土をさわってね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dias curtos desaceleram o crescimento, e a terra fica úmida por muito mais tempo. Sempre sinta a terra antes de regar."
          }
        }
      }
    },
    "Short, friendly and made for real homes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurz, freundlich und für echte Wohnungen gemacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corto, amigable y hecho para casas de verdad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Courts, sympas et pensés pour de vrais intérieurs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短くて親しみやすく、リアルな暮らしに合わせて。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curtinhos, tranquilos e feitos pra casa de verdade."
          }
        }
      }
    },
