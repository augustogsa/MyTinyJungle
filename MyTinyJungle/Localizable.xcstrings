    "Push a finger 2–3 cm into the soil. Dry? Water. Still cool and damp? Wait a day or two." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steck einen Finger 2–3 cm in die Erde. Trocken? Gießen. Noch kühl und feucht? Ein, zwei Tage warten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mete un dedo 2–3 cm en la tierra. ¿Seca? Riega. ¿Todavía fresca y húmeda? Espera uno o dos días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfonce un doigt de 2 ou 3 cm dans la terre. Sèche ? Arrose. Encore fraîche et humide ? Attends un jour ou deux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "土に指を2〜3cm差し込んでみて。乾いてる？ 水やり。まだひんやり湿ってる？ 1〜2日待ってね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfie o dedo 2–3 cm na terra. Seca? Regue. Ainda fresca e úmida? Espere um ou dois dias."
          }
        }
      }
    },
    "Push one finger in near the edge of the pot, away from the stem." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steck einen Finger nahe am Topfrand rein, weg vom Stamm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mete un dedo cerca del borde de la maceta, lejos del tallo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfonce un doigt près du bord du pot, loin de la tige."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "茎から離れた鉢のふち近くに、指を1本差し込みます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfie um dedo perto da borda do vaso, longe do caule."
          }
        }
      }
    },
    "Put fresh mix at the bottom so the plant sits at the same depth" : {
      "comment" : "Repotting step; imperative; max 70 chars",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frische Erde nach unten, damit die Pflanze gleich tief sitzt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon mezcla nueva en el fondo para que la planta quede a la misma profundidad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mets du mélange frais au fond pour que la plante soit à la même profondeur"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい土を底に入れて、植物が同じ深さになるようにする"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque substrato novo no fundo pra planta ficar na mesma altura"
          }
        }
      }
    },
    "Put it in a jar so the node is under water but the leaves stay dry." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell ihn in ein Glas, sodass der Knoten unter Wasser ist und die Blätter trocken bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponlo en un frasco con el nudo bajo el agua y las hojas secas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mets-la dans un bocal, le nœud sous l'eau et les feuilles au sec."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "節が水につかって、葉は濡れないように瓶に入れます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque num pote com o nó debaixo d’água e as folhas pra fora."
          }
        }
      }
    },
    "Put the node under water, leaves above. Bright, indirect light." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knoten unter Wasser, Blätter darüber. Hell, aber indirekt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nudo bajo el agua y las hojas afuera. Luz indirecta brillante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nœud sous l'eau, les feuilles au-dessus. Lumière vive indirecte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "節は水の中、葉は水の上に。明るい間接光の場所へ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o nó debaixo d’água e as folhas pra fora. Luz clara e indireta."
          }
        }
      }
    },
