    "Plastic or glazed ceramic" : {
      "comment" : "Pot material recommendation; max 28 chars",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunststoff oder glasierte Keramik"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plástico o cerámica esmaltada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plastique ou céramique émaillée"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラスチックか釉薬つきの陶器"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plástico ou cerâmica esmaltada"
          }
        }
      }
    },
    "Plastic or glazed ceramic holds moisture better." : {
      "comment" : "Welcome care plan for a newly added plant.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunststoff oder glasierte Keramik hält Feuchtigkeit besser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plástico o la cerámica esmaltada retienen mejor la humedad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plastique ou la céramique émaillée retient mieux l'humidité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラスチックや釉薬つきの陶器のほうが水分を保ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plástico ou cerâmica esmaltada seguram melhor a umidade."
          }
        }
      }
    },
    "Please bring %@ inside or wrap them in fleece tonight. Frost hurts tender leaves overnight." : {
      "comment" : "Weather alert detail. %@ = plant names list. Fleece = manta/TNT de proteção.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hol %@ heute Nacht bitte rein oder pack sie in Vlies. Frost schadet zarten Blättern über Nacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porfa, mete a %@ o envuélvelas en una mantita esta noche. La helada daña las hojas delicadas en una sola noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rentre %@ ou emmitoufle-les dans un voile d'hivernage ce soir. Le gel abîme les feuilles fragiles pendant la nuit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜は%@を室内に入れるか、不織布でくるんであげてね。霜はひと晩でやわらかい葉を傷めます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve %@ pra dentro ou cubra com uma manta hoje à noite. A geada da madrugada machuca as folhas delicadas."
          }
        }
      }
    },
    "Please never feed me. I catch my own food, and fertilizer burns my roots. Rainwater only." : {
      "comment" : "Plant chat: carnivorous plant, never fertilize.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte dünge mich nie. Ich fange mein Futter selbst, und Dünger verbrennt meine Wurzeln. Nur Regenwasser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porfa, nunca me abones. Atrapo mi propia comida, y el fertilizante me quema las raíces. Solo agua de lluvia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne me donne jamais d'engrais, s'il te plaît. J'attrape ma propre nourriture, et l'engrais brûle mes racines. Uniquement de l'eau de pluie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぼくには絶対に肥料をあげないでね。自分でごはんを捕まえるし、肥料は根っこを傷めちゃう。水は雨水だけ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, nunca me adube. Eu caço minha própria comida, e adubo queima minhas raízes. Só água da chuva."
          }
        }
      }
    },
    "Plus" : {
      "shouldTranslate" : false
    },
    "Point at the back label. I'll check it\nagainst every plant you have." : {
