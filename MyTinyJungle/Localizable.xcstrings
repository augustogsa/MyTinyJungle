    "Did I get my care? If you already did it, just tell me." : {
      "comment" : "Plant speaking in chat, first person, asks if the user already did the overdue care, friendly, no guilt.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já cuidou de mim? Se já fez, é só me falar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ya me cuidaste? Si ya lo hiciste, solo dímelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu t'es déjà occupé de moi ? Si c'est fait, dis-le-moi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
