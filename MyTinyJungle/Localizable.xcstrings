    "Spider plants, calatheas, parlour palms, peperomias, money trees and African violets are on the ASPCA safe list." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grünlilie, Calathea, Bergpalme, Peperomie, Glückskastanie und Usambaraveilchen stehen auf der ASPCA-Liste der sicheren Pflanzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mala madre, las calateas, la palmera de salón, las peperomias, el árbol del dinero y las violetas africanas están en la lista segura de la ASPCA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chlorophytums, calatheas, palmiers nains, pépéromias, pachiras et violettes africaines sont sur la liste sans danger de l'ASPCA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オリヅルラン、カラテア、テーブルヤシ、ペペロミア、パキラ、セントポーリアはASPCAの安全リストに入っています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clorofito, calateias, palmeira-chamaedorea, peperômias, pacheira e violetas-africanas estão na lista de plantas seguras da ASPCA."
          }
        }
      }
    },
