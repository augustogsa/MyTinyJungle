        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me manda uma foto da folha?"
          }
        }
      }
    },
    "Can't be ruled out from a photo. Check under the leaves" : {
      "comment" : "Health analysis pests value; friendly advice; max 70 chars",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Foto nicht auszuschließen. Schau unter die Blätter"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede descartar con una foto. Revisa bajo las hojas"
