    "Rest it on gritty mix in bright light. Mist the soil lightly once roots appear." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg es auf körnige Erde ins helle Licht. Sobald Wurzeln da sind, die Erde leicht besprühen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponla sobre mezcla arenosa con buena luz. Rocía la tierra apenas salgan raíces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose-la sur un mélange graveleux, en pleine lumière. Brumise légèrement la terre dès que les racines apparaissent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粒の粗い土の上に置いて、明るい場所へ。根が出てきたら土に軽く霧吹きします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoie sobre substrato arenoso em luz forte. Borrife a terra de leve quando as raízes aparecerem."
          }
        }
      }
    },
