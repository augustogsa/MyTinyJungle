    "Peat-free compost or coco coir holds water and gives roots something soft to grow into." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torffreie Erde oder Kokosfaser hält Wasser und gibt Wurzeln etwas Weiches zum Reinwachsen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La composta sin turba o la fibra de coco retienen agua y les dan a las raíces algo suavecito donde crecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un terreau sans tourbe ou de la fibre de coco retient l'eau et offre aux racines un milieu doux où pousser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピートフリーの培養土やココピートは水もちがよく、根がやわらかく伸びていけます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terra vegetal ou fibra de coco segura a água e deixa um meio macio pras raízes crescerem."
