          }
        }
      }
    },
    "Holes at the bottom are essential. A pretty pot without holes can be a cover pot instead." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löcher im Boden sind ein Muss. Ein hübscher Topf ohne Löcher taugt als Übertopf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los agujeros en el fondo son esenciales. Una maceta bonita sin agujeros puede usarse como cubremaceta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les trous au fond sont indispensables. Un joli pot sans trous peut servir de cache-pot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鉢底の穴は必須。穴のないおしゃれな鉢は、鉢カバーとして使ってね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Furo no fundo é essencial. Um vaso bonito sem furo pode virar cachepô."
          }
        }
      }
    },
