        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minha terra tá seca, hora de um golinho."
          }
        }
      }
    },
    "My soil is dry now. A slow, deep drink would be lovely." : {
      "comment" : "Plant speaking in chat, request water, calm personality: gentle, unhurried, serene.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Erde ist jetzt trocken. Ein langsamer, tiefer Schluck wäre schön."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi tierra ya está seca. Un riego lento y profundo me encantaría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma terre est sèche maintenant. Un arrosage lent et profond, ce serait parfait."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
