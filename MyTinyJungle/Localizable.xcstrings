    "Shower the leaves, especially undersides, with lukewarm water." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brause die Blätter, vor allem die Unterseiten, mit lauwarmem Wasser ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baña las hojas, sobre todo por abajo, con agua tibia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Douche les feuilles à l'eau tiède, surtout le dessous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぬるま湯で葉に、とくに裏側にシャワーをかけます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê um banho nas folhas, principalmente na parte de baixo, com água morna."
          }
        }
      }
    },
