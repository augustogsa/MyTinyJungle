    "%@ has been getting drinks closer together than it dries. Let it rest a few days and feel the soil first." : {
      "comment" : "Insight: overwatering pattern. %@ = plant name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bekommt öfter Wasser, als die Erde trocknet. Gönn ihr ein paar Tage Pause und fühl erst die Erde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha recibido agua más seguido de lo que tarda en secarse. Déjala descansar unos días y toca la tierra primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été arrosée plus souvent qu'elle ne sèche. Laisse-la souffler quelques jours et tâte la terre d'abord."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は、乾くより早いペースでお水をもらっています。数日お休みして、まず土をさわってみてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está recebendo água antes de a terra secar. Espere uns dias e cheque a terra antes."
          }
        }
      }
    },
    "%@ has been with you %lld days. Look how far you've come." : {
