    "Use about a fifth of the pot's volume. I'll show the exact amount for your pot." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm etwa ein Fünftel des Topfvolumens. Ich zeig dir die genaue Menge für deinen Topf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa como un quinto del volumen de la maceta. Te muestro la cantidad exacta para la tuya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte environ un cinquième du volume du pot. Je t'indiquerai la quantité exacte pour ton pot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鉢の容量の約1/5が目安。あなたの鉢にぴったりの量を表示します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use cerca de um quinto do volume do vaso. O app mostra a quantidade certa pro seu vaso."
          }
        }
      }
    },
