    "Easy food for pots: %@. Ask me about any of them, like \"how do I grow chillies\"." : {
      "comment" : "Chat: easy edible plants for pots. %@ = list of crop names. Translate the example naturally (e.g. 'como plantar pimenta').",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leichtes Essen aus dem Topf: %@. Frag mich zu allem, z. B. „Wie ziehe ich Chilis?“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comida fácil de cultivar en maceta: %@. Pregúntame por cualquiera, como \"¿cómo cultivo chiles?\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des récoltes faciles en pot : %@. Demande-moi pour n'importe laquelle, par exemple « comment faire pousser des piments »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鉢でかんたんに育つ野菜：%@。「唐辛子の育て方は？」みたいに、なんでも聞いてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comida fácil de plantar em vaso: %@. Me pergunte sobre qualquer uma, tipo \"como plantar pimenta\"."
          }
        }
      }
    },
