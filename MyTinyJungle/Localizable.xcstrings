        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Do jeito que estou agora, costumo secar em uns %lld dia. Vou aprender meu ritmo de verdade com os seus toques na terra."
