    "%@ until %@": {
      "comment": "Hub row subtitle; %1$@ plant, %2$@ date",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ até %2$@"
          }
        }
      }
    },
    "%@ Usually every %lld–%lld days indoors. I'll learn the real rhythm from your checks.": {
      "comment": "Welcome care plan for a newly added plant. Args: watering rule, min and max days.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ Usually every %2$lld–%3$lld days indoors. I'll learn the real rhythm from your checks."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Normalmente a cada %2$lld–%3$lld dias dentro de casa. Vou aprender o ritmo real com as suas checagens."
          }
        }
      }
    },
    "%@ and %lld more are ready for a little love today.": {
      "comment": "Notification body; %@ three plant names, %lld how many more (plural)",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ and %2$lld more is ready for a little love today."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ and %2$lld more are ready for a little love today."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ e mais %2$lld estão prontinhas pra um carinho hoje."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ e mais %2$lld estão prontinhas pra um carinho hoje."
                }
              }
            }
          }
        }
      }
    },
    "%@ and friends": {
      "comment": "Weather alert: first three plant names, then 'and friends'. %@ = comma list of names.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ e companhia"
          }
        }
      }
    },
    "%@ are ready for a little love today.": {
      "comment": "Notification body; %@ list of 2-3 plant names",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ estão prontinhas pra um carinho hoje."
          }
        }
      }
    },
    "%@ can upset furry friends if nibbled. Maybe a higher shelf?": {
      "comment": "Notification line; %@ plant name; toxic to pets; playful",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pode fazer mal aos peludos se for mordiscada. Que tal uma prateleira mais alta?"
          }
        }
      }
    },
    "%@ catches its own food. Fertilizer burns its roots.": {
      "comment": "Product scan verdict reason for one plant. Args are plant or species names, numbers.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ caça a própria comida. Adubo queima as raízes."
          }
        }
      }
    },
    "%@ could use a roomier pot %@": {
      "comment": "Forecast line on Today/agenda, warm, no final period. Args: plant name, when.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ could use a roomier pot %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ia gostar de um vaso maior %2$@"
          }
        }
      }
    },
    "%@ cutting": {
      "comment": "Propagation row title; arg is parent plant name",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda de %@"
          }
        }
      }
    },
    "%@ drinks through its leaves. Use at ¼ strength in the soaking water.": {
      "comment": "Product scan verdict reason for one plant. Args are plant or species names, numbers.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bebe pelas folhas. Use ¼ da dose na água de molho."
          }
        }
      }
    },
    "%@ for your plants": {
      "comment": "Season guide title, e.g. Summer for your plants",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pras suas plantas"
          }
        }
      }
    },
    "%@ green": {
      "comment": "Health analysis value: share of green leaf area, e.g. 82% green; max 14 chars",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verde"
          }
        }
      }
    },
    "%@ has been getting drinks closer together than it dries. Let it rest a few days and feel the soil first.": {
      "comment": "Insight: overwatering pattern. %@ = plant name.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está recebendo água antes de dar tempo de secar. Deixe descansar uns dias e sinta a terra antes."
          }
        }
      }
    },
    "%@ has been with you %lld days. Look how far you've come.": {
      "comment": "Insight: milestone. Args: plant name, days (plural).",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ has been with you %2$lld day. Look how far you've come."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ has been with you %2$lld days. Look how far you've come."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ está com você há %2$lld dia. Olha quanto vocês já caminharam."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ está com você há %2$lld dias. Olha quanto vocês já caminharam."
                }
              }
            }
          }
        }
      }
    },
    "%@ hasn't had a visit in a while. A quick hello would make its day.": {
      "comment": "Insight: plant misses you. %@ = plant name.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não recebe uma visita faz tempo. Um oi rapidinho ia alegrar o dia dela."
          }
        }
      }
    },
    "%@ hate wet feet. Tuck them under cover or tip out saucers after the rain.": {
      "comment": "Weather alert detail. %@ = plant names list. Saucers = pratinhos.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ odeiam pé molhado. Coloque num lugar coberto ou esvazie os pratinhos depois da chuva."
          }
        }
      }
    },
    "%@ in a pot: %@. Pot at least %lld L and %lld cm deep, %lld cm apart.\n• When: %@\n• Sprouts in %@ days, harvest in about %@ days.\n• Keep above %@.\n• %@": {
      "comment": "Crop growing card; keep the line breaks and bullets",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ in a pot: %2$@. Pot at least %3$lld L and %4$lld cm deep, %5$lld cm apart.\n• When: %6$@\n• Sprouts in %7$@ days, harvest in about %8$@ days.\n• Keep above %9$@.\n• %10$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ em vaso: %2$@. Vaso de pelo menos %3$lld L e %4$lld cm de fundura, com %5$lld cm entre as plantas.\n• Quando: %6$@\n• Germina em %7$@ dias, colheita em cerca de %8$@ dias.\n• Mantenha acima de %9$@.\n• %10$@"
          }
        }
      }
    },
    "%@ is a light feeder. Use half the label dose.": {
      "comment": "Product scan verdict reason for one plant. Args are plant or species names, numbers.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ come pouco. Use metade da dose do rótulo."
          }
        }
      }
    },
    "%@ is dreaming of a misty morning": {
      "comment": "Forecast line on Today/agenda, warm, no final period. Misting reminder. %@ = plant name.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está sonhando com uma borrifada"
          }
        }
      }
    },
    "%@ is stressed. Fix the water and light first, since repotting adds stress.": {
      "comment": "Repot verdict explanation; arg plant name",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está estressada. Acerte a água e a luz primeiro, porque trocar o vaso estressa mais."
          }
        }
      }
    },
    "%@ is toxic to pets if chewed (ASPCA). Keep it out of reach.": {
      "comment": "Care reason: pet safety. %@ = species common name.",
      "localizations": {
