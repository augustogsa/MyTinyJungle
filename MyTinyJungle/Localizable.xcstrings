    "%@ asked you to plant-sit %@ until %@. My Tiny Jungle shows you exactly what each plant needs, and you'll earn a Plant sitter badge." : {
      "comment" : "Sitter invite message; %1$@ inviter, %2$@ jungle name, %3$@ date",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ möchte, dass du dich bis %@ um %@ kümmerst. My Tiny Jungle zeigt dir genau, was jede Pflanze braucht, und du bekommst das Abzeichen „Pflanzensitter“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ te pidió que cuides %@ hasta %@. My Tiny Jungle te muestra exactamente lo que necesita cada planta, y ganarás la insignia de Cuidaplantas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ te demande de garder %@ jusqu'au %@. My Tiny Jungle te montre exactement ce dont chaque plante a besoin, et tu gagneras le badge Plant-sitter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@から、%3$@まで%2$@のお留守番ケアを頼まれました。My Tiny Jungleが植物ごとに必要なことをちゃんと教えてくれるし、「プラントシッター」バッジももらえます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ te chamou para ser babá de %2$@ até %3$@. O My Tiny Jungle mostra direitinho o que cada planta precisa, e você ganha a conquista Babá de plantas."
          }
        }
      }
    },
    "%@ can upset furry friends if nibbled. Maybe a higher shelf?" : {
      "comment" : "Notification line; %@ plant name; toxic to pets; playful",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann Fellnasen nicht gut bekommen, wenn sie dran knabbern. Vielleicht ein höheres Regal?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ le puede caer mal a tus peludos si la mordisquean. ¿Quizás en una repisa más alta?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ peut rendre malades nos amis à poils s'ils la grignotent. Une étagère plus haute, peut-être ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はペットがかじると具合が悪くなることがあります。もう少し高い棚はどうでしょう？"
