      }
    },
    "In my current setup I usually dry in about %lld days. I'll learn my real rhythm from your soil checks.": {
      "comment": "Plant chat: estimated drying rhythm. %lld = days (plural).",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "In my current setup I usually dry in about %lld day. I'll learn my real rhythm from your soil checks."
                }
              },
