    },
    "Cut if needed" : {
      "comment" : "Care guide step title; short",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Bedarf schneiden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta si hace falta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe si besoin"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なら切る"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corte, se precisar"
          }
        }
      }
    },
    "Cut just below a node (the bump where a leaf meets the stem), with 1–2 leaves. Keep it warm, in bright indirect light. Change the water weekly." : {
      "comment" : "Propagation instructions",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneid knapp unter einem Knoten (die Verdickung, wo ein Blatt am Stiel sitzt), mit 1–2 Blättern. Warm und hell, aber indirekt stellen. Wasser wöchentlich wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta justo debajo de un nudo (el bultito donde la hoja se une al tallo), con 1–2 hojas. Mantenlo calientito, con luz indirecta brillante. Cambia el agua cada semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe juste sous un nœud (la bosse où la feuille rejoint la tige), avec 1 ou 2 feuilles. Garde-la au chaud, en lumière vive indirecte. Change l'eau chaque semaine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "節（葉と茎のつけ根のふくらみ）のすぐ下で、葉を1〜2枚つけて切ります。暖かくて明るい間接光の場所に置き、水は毎週替えてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corte logo abaixo de um nó (a saliência onde a folha encontra o caule), com 1–2 folhas. Deixe num lugar quente, com luz indireta forte. Troque a água toda semana."
          }
        }
      }
    },
