    "Slightly more light than ideal" : {
      "comment" : "Placement reason, no final period.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas mehr Licht als ideal"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un poco más de luz de lo ideal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un peu plus de lumière que l'idéal"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "理想より少し明るめ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pouco mais de luz que o ideal"
          }
        }
      }
    },
    "Slow-release granules build up salts in dry-kept soil. Liquid feed is safer." : {
      "comment" : "Product scan verdict reason for one plant. Args are plant or species names, numbers.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langzeitdünger-Granulat sammelt in trocken gehaltener Erde Salze an. Flüssigdünger ist sicherer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gránulos de liberación lenta acumulan sales en tierra que se mantiene seca. El abono líquido es más seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les granulés à libération lente accumulent du sel dans une terre gardée sèche. L'engrais liquide est plus sûr."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緩効性の粒状肥料は、乾かしぎみの土だと塩分がたまります。液体肥料のほうが安全です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grânulos de liberação lenta acumulam sais em terra mantida seca. Adubo líquido é mais seguro."
          }
        }
      }
    },
    "Slow, deep rinse" : {
      "comment" : "Care guide step title; short",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsam und gründlich spülen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enjuague lento y profundo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rinçage lent et profond"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆっくり、たっぷり洗い流す"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enxágue lento e profundo"
          }
        }
      }
    },
    "Slowly, until a little drains out, then empty the saucer." : {
      "comment" : "Watering method",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsam, bis etwas unten rausläuft, dann den Untersetzer leeren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Despacio, hasta que escurra un poquito, y luego vacía el plato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doucement, jusqu'à ce qu'un peu d'eau s'écoule, puis vide la soucoupe."
