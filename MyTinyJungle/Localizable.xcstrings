    "This water is SO last week. Fresh water, please, I'm begging." : {
      "comment" : "Plant speaking in chat, first person, fresh water for a plant growing in water, dramatic.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa água é TÃO semana passada. Água nova, por favor, tô implorando."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta agua es TAN de la semana pasada. Agua fresca, por favor, te lo ruego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette eau date TELLEMENT de la semaine dernière. De l'eau fraîche, je t'en supplie."
