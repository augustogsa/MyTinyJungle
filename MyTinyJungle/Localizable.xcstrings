        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Mmm, gracias! Lo voy a convertir en brotes nuevos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miam, merci ! Je vais en faire de nouvelles pousses."
