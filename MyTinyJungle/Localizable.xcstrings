    "Match its light needs, then try not to move it while it settles." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passend zum Lichtbedarf stellen und dann möglichst nicht umstellen, während sie sich einlebt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale la luz que necesita y trata de no moverla mientras se adapta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respecte ses besoins en lumière, puis évite de la déplacer pendant qu'elle s'installe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好きな光に合わせたら、落ち着くまでなるべく動かさないでね。"
