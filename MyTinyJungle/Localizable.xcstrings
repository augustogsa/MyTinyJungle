{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "\n• Good neighbours: %@.": {
      "comment": "Crop card line: companion plants list; keep the leading line break and bullet",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n• Boas vizinhas: %@."
          }
        }
      }
    },
    " ": {
      "comment": "Spacer placeholder; keep a single space",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " "
          }
        }
      }
    },
    " Keep away from: %@.": {
      "comment": "Crop card: plants to keep away; keep the leading space",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Mantenha longe de: %@."
          }
        }
      }
    },
    "%@ %@": {
      "comment": "Care task title: verb then plant name, e.g. Water Monstera",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@ e.g. %@.": {
      "comment": "Plant family step: traits, care, example plants",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ e.g. %3$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ Ex.: %3$@."
          }
        }
      }
    },
    "%@ (%@ lux): %@. Think %@.": {
      "comment": "Chat: light level line. Args: level name, lux range, where in a home, example plants.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@ lux): %3$@. Think %4$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@ lux): %3$@. Pense em %4$@."
          }
        }
      }
    },
    "%@ (for %@): %@ %@ Careful: %@": {
      "comment": "Chat: home remedy line. Args: remedy name, what it's for, recipe, how to use, caution.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (for %2$@): %3$@ %4$@ Careful: %5$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (para %2$@): %3$@ %4$@ Cuidado: %5$@"
          }
        }
      }
    },
    "%@ (you)": {
      "comment": "Member row name for yourself",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (você)"
          }
        }
      }
    },
    "%@ Always water first. Never feed dry roots. Scan any bottle at the shop and I'll tell you if it suits me.": {
      "comment": "Plant chat: feeding advice. %@ = species feeding plan sentence.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sempre regue antes. Nunca adube raiz seca. Escaneie qualquer frasco na loja e eu digo se combina comigo."
          }
        }
      }
    },
    "%@ asked %@ to take %@.": {
      "comment": "Feed: cover request to one member; %1$@ name, %2$@ other name, %3$@ plant",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pediu para %2$@ cuidar de %3$@."
          }
        }
      }
    },
    "%@ asked for a hand with %@.": {
      "comment": "Feed: cover request to everyone; %1$@ name, %2$@ plant",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pediu uma mãozinha com %2$@."
          }
        }
      }
    },
    "%@ cared for %@.": {
      "comment": "Shared jungle feed, generic care; %1$@ member, %2$@ plant",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cuidou de %2$@."
          }
        }
      }
    },
    "%@ could use a hand": {
      "comment": "Notification title: member asks for help; %@ first name",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ precisa de uma mãozinha"
          }
        }
      }
    },
    "%@ fed %@.": {
      "comment": "Shared jungle feed; %1$@ member, %2$@ plant",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ adubou %2$@."
          }
        }
      }
    },
    "%@ Harvest in about %@ days. %@": {
      "comment": "Crop step: how to start, days to harvest, tip",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ Harvest in about %2$@ days. %3$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Colha em cerca de %2$@ dias. %3$@"
          }
        }
      }
    },
    "%@ has got %@. Enjoy the break.": {
      "comment": "Notification: member accepted covering; %1$@ name, %2$@ plant name",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vai cuidar de %2$@. Aproveite a folga."
          }
        }
      }
    },
    "%@ has today's care. Enjoy a day off.": {
      "comment": "Shared card: other member's turn; %@ first name",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje é com %@. Aproveite a folga."
          }
        }
      }
    },
    "%@ If I stretch toward the window or my new leaves come out small, I need more light. Bleached or scorched patches mean too much direct sun.": {
      "comment": "Plant chat: light advice. %@ = species light rule sentence.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Se eu esticar em direção à janela ou as folhas novas saírem pequenas, preciso de mais luz. Manchas desbotadas ou queimadas são sol direto demais."
          }
        }
      }
    },
    "%@ invited you to care for %@ together on My Tiny Jungle. We'll take turns, and the app tells us whose turn it is.": {
      "comment": "Invite message text; %1$@ inviter name, %2$@ jungle name",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ convidou você para cuidar de %2$@ juntos no My Tiny Jungle. A gente reveza, e o app avisa de quem é a vez."
          }
        }
      }
    },
    "%@ is away. %@ is covering.": {
      "comment": "Feed: member travelling, other covers; %1$@ name, %2$@ cover name",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está fora. %2$@ está cobrindo."
          }
        }
      }
    },
    "%@ is away. Turns are shared meanwhile.": {
      "comment": "Feed: member travelling; %@ name",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está fora. Enquanto isso, a vez é dividida."
          }
        }
