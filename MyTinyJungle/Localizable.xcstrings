    "Reservoir full. Thank you!" : {
      "comment" : "Plant thanks the user after its reservoir was topped up.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reservatório cheio. Valeu!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depósito lleno. ¡Gracias!"
          }
        },
        "fr" : {
