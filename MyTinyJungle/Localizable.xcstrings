            "value" : "Água de chuva"
          }
        }
      }
    },
    "Rainwater, sun, and no food" : {
      "comment" : "Care guide subtitle; short",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regenwasser, Sonne und kein Futter"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agua de lluvia, sol y nada de comida"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eau de pluie, soleil et pas d'engrais"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雨水、日光、肥料なし"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Água de chuva, sol e nada de adubo"
          }
        }
      }
    },
    "Rainy season in %@. Plants grow fast; feed them and watch for soggy pots." : {
      "comment" : "Season card. %@ = place.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regenzeit in %@. Pflanzen wachsen schnell: düngen und auf durchnässte Töpfe achten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temporada de lluvias en %@. Las plantas crecen rápido; abónalas y ojo con las macetas encharcadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saison des pluies à %@. Les plantes poussent vite : nourris-les et surveille les pots détrempés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は雨季。植物がぐんぐん育つので、肥料をあげて、鉢が水浸しにならないよう気をつけてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estação chuvosa em %@. As plantas crescem rápido: adube e fique de olho nos vasos encharcados."
          }
        }
      }
    },
    "Raise humidity: mites love dry air" : {
      "comment" : "Pest treatment step; imperative, short; max 70 chars",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luftfeuchte erhöhen: Milben lieben trockene Luft"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube la humedad: los ácaros aman el aire seco"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augmente l'humidité : les acariens adorent l'air sec"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "湿度を上げる：ハダニは乾燥が大好き"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumente a umidade: ácaros adoram ar seco"
