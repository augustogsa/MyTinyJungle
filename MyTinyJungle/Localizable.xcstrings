    "Call your vet or a pet poison helpline, and have the plant's name ready." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruf deinen Tierarzt oder den Giftnotruf an und halte den Pflanzennamen bereit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llama a tu veterinario o a una línea de intoxicación de mascotas, y ten a mano el nombre de la planta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appelle ton véto ou le centre antipoison animal, avec le nom de la plante sous la main."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "獣医さんかペットの中毒相談窓口に連絡して、植物の名前を伝えられるようにしておいてね。"
          }
        },
        "pt-BR" : {
