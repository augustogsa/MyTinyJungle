          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva sola. Cancela cuando quieras en Configuración, sin rencores. Tus plantas siguen siendo tuyas de todos modos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement automatique. Annule quand tu veux dans Réglages, sans rancune. Tes plantes restent à toi dans tous les cas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動更新されます。「設定」からいつでも解約OK、気にしないでね。どちらにしても、植物はずっとあなたのものです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
