    "Winter dust blocks light. A gentle shower freshens everyone up." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Winterstaub schluckt Licht. Eine sanfte Dusche macht alle wieder frisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El polvo del invierno tapa la luz. Una regaderita suave refresca a todas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La poussière d'hiver bloque la lumière. Une petite douche rafraîchit tout le monde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冬のほこりは光をさえぎります。やさしくシャワーをかければ、みんなさっぱり。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A poeira do inverno bloqueia a luz. Um banho leve renova todo mundo."
          }
        }
      }
    },
    "Winter in %@ with the heating on. Less water, no food, and keep them away from radiators." : {
      "comment" : "Season card. %@ = place. Radiators = aquecedores.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Winter in %@ mit Heizung. Weniger Wasser, kein Futter, und weg von der Heizung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invierno en %@ con la calefacción prendida. Menos agua, nada de comida y lejos de los calefactores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'hiver à %@ avec le chauffage allumé. Moins d'eau, pas d'engrais, et loin des radiateurs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は冬で暖房中。水は少なめ、肥料なし、暖房器具から離してね。"
