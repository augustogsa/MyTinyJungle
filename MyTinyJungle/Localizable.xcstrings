    "Never remove more than a quarter of the plant at once." : {
      "comment" : "Care guide step tip",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm nie mehr als ein Viertel der Pflanze auf einmal weg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca quites más de un cuarto de la planta a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'enlève jamais plus d'un quart de la plante d'un coup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度に株の1/4以上は切らないでね。"
          }
