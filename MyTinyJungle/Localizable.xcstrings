    "Deep, slow, then drain": {
      "comment": "Care guide subtitle; short",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fundo, devagar, depois escorra"
          }
        }
      }
    },
    "Dilute, never on dry soil": {
      "comment": "Care guide subtitle; short",
      "localizations": {
