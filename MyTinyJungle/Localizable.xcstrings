    "Keep feeding at quarter strength while leaves and roots grow." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dünge weiter in Viertelstärke, während Blätter und Wurzeln wachsen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue abonando a un cuarto de dosis mientras crecen hojas y raíces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue l'engrais au quart de la dose pendant que feuilles et racines poussent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "葉と根が育つあいだは、1/4の濃さで肥料を続けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue adubando com um quarto da dose enquanto folhas e raízes crescem."
          }
        }
      }
    },
    "Keep it 20–40 cm above the leaves. Light weakens quickly with distance." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte sie 20–40 cm über den Blättern. Licht wird mit Abstand schnell schwächer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponla a 20–40 cm de las hojas. La luz se debilita rápido con la distancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place-la à 20 ou 40 cm au-dessus des feuilles. La lumière baisse vite avec la distance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "葉から20〜40cm上に設置してね。光は距離が離れるとすぐ弱まります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe a 20–40 cm acima das folhas. A luz enfraquece rápido com a distância."
          }
        }
      }
    },
