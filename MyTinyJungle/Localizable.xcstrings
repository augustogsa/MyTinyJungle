        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hora da aguinha! Minha terra secou."
          }
        }
      }
    },
    "Drinks" : {
      "comment" : "Reminder kind title in Settings, playful. Max 22 chars.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drinks"
          }
        },
        "es" : {
          "stringUnit" : {
