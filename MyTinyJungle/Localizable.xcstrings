    "Orchids need weak feeds. Use at ¼ strength.": {
      "comment": "Product scan verdict reason for one plant. Args are plant or species names, numbers.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Orquídeas precisam de adubo fraco. Use ¼ da dose."
