            "state": "translated",
            "value": "Suas plantas"
          }
        }
      }
    },
    "Your plants are patient. Anything that would arrive during quiet hours waits until morning.": {
      "comment": "Settings footer",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas plantas são pacientes. O que chegaria no horário de descanso espera até de manhã."
          }
        }
      }
    },
    "Your plants are thinking of you.": {
      "comment": "Notification body fallback",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas plantinhas estão pensando em você."
          }
        }
      }
    },
    "Your plants show up on their iPhone, turns included": {
      "comment": "Invite how-it-works step",
      "extractionState": "manual",
