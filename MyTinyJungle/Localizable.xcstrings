      }
    },
    "I don't know my species yet, so I can't answer that well. Tell me what kind of plant I am, or open my profile and pick it.": {
      "comment": "Plant chat: plant has no species set.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não sei minha espécie, então não consigo responder direito. Me conta que planta eu sou, ou abre meu perfil e escolhe."
          }
        }
      }
    },
    "I flowered!": {
      "comment": "Timeline line, plant voice, proud",
      "localizations": {
        "pt-BR": {
