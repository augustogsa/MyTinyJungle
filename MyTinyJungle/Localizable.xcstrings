    "use a balanced feed, then a high-potassium one while it flowers" : {
      "comment" : "Feeding instruction, starts lowercase with a verb, completes 'then …'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nimm Volldünger, dann während der Blüte einen kaliumreichen"
