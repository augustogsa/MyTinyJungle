    },
    "Hi! I'm Erty, your plants' best friend, here to help you care for them. What should I call you?" : {
      "comment" : "Setup chat: first mascot question",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi! Ich bin Zweigi, der beste Freund deiner Pflanzen, und helfe dir, dich um sie zu kümmern. Wie soll ich dich nennen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola! Soy Ramito, el mejor amigo de tus plantas, y vengo a ayudarte a cuidarlas. ¿Cómo te llamo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou ! Moi c'est Brindille, la meilleure amie de tes plantes, là pour t'aider à t'en occuper. Comment je dois t'appeler ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは！ 植物たちの親友、アーティーです。お世話のお手伝いをします。なんて呼べばいいですか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi! Eu sou o Raminho, o melhor amigo das suas plantas, e tô aqui pra te ajudar a cuidar delas. Como posso te chamar?"
          }
        }
      }
    },
