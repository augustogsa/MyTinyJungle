    "Long sunny days. Peek at the soil a little more often." : {
      "comment" : "Summer tip",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lange, sonnige Tage. Schau etwas öfter nach der Erde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Días largos y soleados. Échale un ojo a la tierra un poco más seguido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De longues journées ensoleillées. Jette un œil à la terre un peu plus souvent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晴れの日が長い季節。土をいつもより少しこまめにのぞいてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dias longos e ensolarados. Confira a terra com mais frequência."
          }
        }
      }
    },
    "Look for separate crowns or clumps and tease them apart gently." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Such nach getrennten Rosetten oder Büscheln und zieh sie sanft auseinander."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca coronas o matitas separadas y sepáralas con cuidado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repère les touffes ou rosettes séparées et démêle-les doucement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "株やかたまりが分かれているところを探して、そっとほぐして分けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procure touceiras ou brotos separados e solte com delicadeza."
          }
        }
      }
    },
    "Look how tall I'm getting!" : {
      "comment" : "Plant thanks the user after care action 'measure'. If the line is short and dry it is the independent (terse) personality; if theatrical it is the dramatic one; otherwise warm and cheerful.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schau, wie groß ich werde!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Mira cuánto estoy creciendo!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regarde comme je grandis !"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見て、こんなに背が伸びたよ！"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olha como estou ficando alta!"
          }
        }
      }
    },
    "Look under leaves and along stems for pests before it meets the others." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüf unter den Blättern und an den Stielen auf Schädlinge, bevor sie die anderen trifft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca plagas bajo las hojas y en los tallos antes de que conozca a las demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cherche les nuisibles sous les feuilles et le long des tiges avant qu'elle rencontre les autres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかの子に会わせる前に、葉の裏と茎に害虫がいないか見てね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olhe embaixo das folhas e nos caules atrás de pragas antes de juntar com as outras."
          }
        }
      }
    },
    "Looked after by" : {
