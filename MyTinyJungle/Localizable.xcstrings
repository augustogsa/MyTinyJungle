        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê a cada planta o carinho que ela merece"
          }
        }
      }
    },
    "Give everyone a good soak the day before you leave." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gieß alle am Tag vor der Abreise kräftig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dales a todas un buen remojón el día antes de irte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrose tout le monde à fond la veille de ton départ."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出発の前日に、みんなにたっぷりお水をあげてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regue bem todas as plantas na véspera da viagem."
          }
        }
      }
    },
    "Give it a few days, then water lightly. Keep it in bright, indirect light while it recovers." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib ihr ein paar Tage, dann leicht gießen. Halte sie hell und indirekt, während sie sich erholt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale unos días y luego riega poquito. Mantenla con luz indirecta brillante mientras se recupera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attends quelques jours, puis arrose légèrement. Garde-la en lumière vive indirecte pendant qu'elle récupère."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数日おいてから軽く水やり。回復するまで明るい間接光の場所に置いてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espere alguns dias e regue de leve. Deixe em luz clara e indireta enquanto ela se recupera."
          }
        }
      }
    },
    "Give it two to four weeks to adjust before any big changes." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib ihr zwei bis vier Wochen zum Eingewöhnen, bevor du was Großes änderst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale de dos a cuatro semanas para adaptarse antes de cualquier cambio grande."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse-lui deux à quatre semaines pour s'adapter avant tout gros changement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きく変える前に、2〜4週間なじむ時間をあげてね。"
