    "If you can comfortably read a book there without a lamp, most leafy plants will cope." : {
      "comment" : "Care guide step tip",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannst du dort ohne Lampe gemütlich ein Buch lesen, kommen die meisten Blattpflanzen klar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si puedes leer un libro cómodo ahí sin lámpara, casi todas las plantas de hoja lo aguantan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu peux lire un livre confortablement à cet endroit sans lampe, la plupart des plantes vertes s'en sortiront."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照明なしでラクに本が読める場所なら、たいていの観葉植物は大丈夫です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dá pra ler um livro ali sem acender a luz, a maioria das folhagens fica bem."
          }
        }
      }
