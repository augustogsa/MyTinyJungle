          }
        }
      }
    },
    "Hi everyone! I'm new here. %@." : {
      "comment" : "Plant voice in group chat; arg sentence about its spot",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo zusammen! Ich bin neu hier. %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola a todas! Soy nueva aquí. %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou tout le monde ! Je suis nouvelle ici. %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "みんな、はじめまして！ 新入りです。%@。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi, pessoal! Sou nova por aqui. %@."
          }
        }
      }
    },
    "Hi hi! Could you stick a finger in my soil and tell me how it feels? I think I might be getting dry!" : {
      "comment" : "Plant speaking in chat, request checkSoil, chatty personality: bubbly, talkative, excited.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huhu! Steckst du mal einen Finger in meine Erde und sagst mir, wie sie sich anfühlt? Ich glaub, ich werd langsam trocken!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Holi! ¿Puedes meter un dedo en mi tierra y decirme cómo se siente? ¡Creo que me estoy secando!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou ! Tu pourrais mettre un doigt dans ma terre et me dire ce que tu sens ? Je crois que je commence à sécher !"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やっほー！ 土に指を入れて、どんな感じか教えてくれる？ ちょっと乾いてきた気がするんだ！"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oiê! Coloca o dedo na minha terra e me conta como tá? Acho que tô ficando seca!"
          }
        }
      }
    },
    "Hi, I'm %@! I'm a %@ (%@)." : {
      "comment" : "Plant voice intro in chat; args plant name, common species name, scientific name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi, ich bin %1$@! Ich bin eine %2$@ (%3$@)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hi, I'm %1$@! I'm a %2$@ (%3$@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola, soy %1$@! Soy una %2$@ (%3$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou, je suis %1$@ ! Je suis un(e) %2$@ (%3$@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
