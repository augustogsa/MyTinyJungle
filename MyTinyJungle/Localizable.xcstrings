    "Just checking in. Could you give my soil a little poke?" : {
      "comment" : "Plant speaks up on its own in chat: asks for a soil check. Friendly, first person.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wollte nur mal hören. Stupst du kurz meine Erde an?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo pasaba a saludar. ¿Le das un toquecito a mi tierra?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je passe juste prendre des nouvelles. Tu pourrais tâter un peu ma terre ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ちょっと様子見だよ。土をちょんとつついてくれる？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só passando pra dar um oi. Pode dar uma cutucadinha na minha terra?"
          }
        }
      }
    },
    "Just tell me about a plant, like \"I have a monstera called Milo in the living room\", or add one in Plants with a photo." : {
      "comment" : "Empty body",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzähl mir einfach von einer Pflanze, z. B. „Ich hab eine Monstera namens Milo im Wohnzimmer“, oder füg unter Pflanzen eine mit Foto hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cuéntame de una planta, como \"Tengo una monstera que se llama Milo en la sala\", o agrega una en Plantas con una foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parle-moi simplement d'une plante, comme « J'ai un monstera qui s'appelle Milo dans le salon », ou ajoute-en une dans Plantes avec une photo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「リビングにモンステラのミロがいる」みたいに植物のことを話しかけるか、「植物」タブで写真から追加してね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É só me contar sobre uma planta, tipo \"tenho uma costela-de-adão chamada Milo na sala\", ou adicionar uma em Plantas com uma foto."
          }
        }
      }
    },
