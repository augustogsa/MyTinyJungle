    "Conditions are great for %lld of %lld plants. Consider a humidifier for the humidity lovers." : {
      "comment" : "Space insight; X of Y plants",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bedingungen passen für %1$lld von %2$lld Pflanzen. Ein Luftbefeuchter wäre was für die Feuchtigkeitsfans."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Conditions are great for %1$lld of %2$lld plants. Consider a humidifier for the humidity lovers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las condiciones son ideales para %1$lld de %2$lld plantas. Piensa en un humidificador para las que aman la humedad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conditions sont top pour %1$lld plantes sur %2$lld. Pense à un humidificateur pour celles qui adorent l'humidité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld株中%1$lld株にとって環境はばっちり。湿気好きの子には加湿器も検討してみて。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As condições estão ótimas pra %1$lld de %2$lld plantas. Que tal um umidificador pras que amam umidade?"
          }
        }
      }
    },
