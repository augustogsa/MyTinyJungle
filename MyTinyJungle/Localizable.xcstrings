    "A thin layer of sand or grit makes the surface unwelcoming." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine dünne Schicht Sand oder Splitt macht die Oberfläche ungemütlich."
