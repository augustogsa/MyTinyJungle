    "Aroid mix: about one third bark, a quarter coir, a quarter perlite." : {
      "comment" : "Care guide step tip",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aroiden-Mix: etwa ein Drittel Rinde, ein Viertel Kokosfaser, ein Viertel Perlite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezcla para aráceas: un tercio de corteza, un cuarto de fibra de coco y un cuarto de perlita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mélange pour aracées : environ un tiers d'écorce, un quart de fibre de coco, un quart de perlite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サトイモ科ミックス：バーク約1/3、ココピート1/4、パーライト1/4。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mistura para aráceas: cerca de um terço de casca, um quarto de fibra de coco e um quarto de perlita."
          }
        }
      }
    },
    "As soon as you see webs, white fluff, sticky leaves or tiny flies." : {
      "comment" : "When to do this care guide",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald du Gespinste, weiße Wattebäuschchen, klebrige Blätter oder winzige Fliegen siehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cuanto veas telarañas, pelusa blanca, hojas pegajosas o mosquitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès que tu vois des toiles, du duvet blanc, des feuilles collantes ou de minuscules mouches."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クモの巣、白い綿のようなもの、ベタつく葉、小さな羽虫を見つけたらすぐに。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assim que aparecerem teias, algodão branco, folhas grudentas ou mosquinhas."
          }
        }
      }
    },
