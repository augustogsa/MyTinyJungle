    "Thanks for checking! My soil is dry, so I'd love a drink." : {
      "comment" : "Plant speaking in chat, request water, default voice (cheerful/any personality): warm and friendly.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke fürs Nachschauen! Meine Erde ist trocken, ich hätte gern einen Schluck."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Gracias por revisar! Mi tierra está seca, así que me encantaría un traguito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci d'avoir vérifié ! Ma terre est sèche, alors je boirais bien un coup."
