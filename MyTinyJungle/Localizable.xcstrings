    "Water. Now. I'm begging you, with my whole leaves." : {
      "comment" : "Plant speaking in chat, request water, dramatic personality: over-the-top drama queen, theatrical, CAPS for emphasis (pt: 'dramática', exagerada).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wasser. Jetzt. Ich flehe dich an, mit allen Blättern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agua. Ya. Te lo ruego con todas mis hojas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De l'eau. Maintenant. Je t'en supplie, de toutes mes feuilles."
          }
