    "Snip dead leaves and leggy stems. Every cut can become a new plant." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneid tote Blätter und lange, kahle Triebe ab. Aus jedem Schnitt kann eine neue Pflanze werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta hojas secas y tallos largos y flacos. Cada corte puede ser una planta nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe les feuilles mortes et les tiges dégarnies. Chaque coupe peut devenir une nouvelle plante."
