    "Your partner gets reminders on their turn and sees when you've watered. No more double drinks." : {
      "comment" : "Invite blurb, couple",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Partner wird erinnert, wenn er dran ist, und sieht, wann du gegossen hast. Nie mehr doppelt gießen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pareja recibe recordatorios en su turno y ve cuándo regaste. Se acabaron los riegos dobles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton ou ta partenaire reçoit un rappel à son tour et voit quand tu as arrosé. Fini les doubles arrosages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パートナーには自分の番にリマインダーが届き、あなたが水やりしたこともわかります。もう二重の水やりはなし。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu amor recebe um lembrete quando for a vez dele e vê quando você já regou. Chega de regar duas vezes."
          }
        }
      }
    },
    "Your plan" : {
      "comment" : "Settings title",
