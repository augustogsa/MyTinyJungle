    "Curling" : {
      "comment" : "Care guide step title; short",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingerollt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hojas enroscadas"
