    "Gnat larvae need damp compost. Let the top few centimetres dry between waterings." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trauermückenlarven brauchen feuchte Erde. Lass die oberen Zentimeter zwischen dem Gießen trocknen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las larvas de mosquita necesitan sustrato húmedo. Deja secar los primeros centímetros entre riegos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les larves de moucherons ont besoin d'un terreau humide. Laisse sécher les premiers centimètres entre deux arrosages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キノコバエの幼虫は湿った土が好き。水やりの間に、上から数センチを乾かしてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As larvas precisam de terra úmida. Deixe os primeiros centímetros secarem entre as regas."
          }
        }
      }
    },
    "Go in 2–3 cm" : {
