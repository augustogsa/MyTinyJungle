    "We need your rough location to send alerts. You can allow it in the Settings app." : {
      "comment" : "Settings footer: location missing for weather alerts",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Warnungen brauchen wir deinen ungefähren Standort. Du kannst ihn in der Einstellungen-App erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para enviarte alertas necesitamos tu ubicación aproximada. Puedes permitirla en la app Configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour envoyer des alertes, il nous faut votre position approximative. Vous pouvez l'autoriser dans l'app Réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラートを送るにはおおよその位置情報が必要です。設定アプリで許可できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pra mandar os alertas, a gente precisa da sua localização aproximada. Dá pra liberar no app Ajustes."
          }
        }
      }
    },
    "We'll gently warn you about plants that could hurt them." : {
      "comment" : "Settings footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir warnen dich sanft vor Pflanzen, die ihnen schaden könnten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisaremos con calma de las plantas que podrían hacerles daño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On te préviendra gentiment des plantes qui pourraient leur faire du mal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その子たちに害になりそうな植物は、そっとお知らせします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisamos sobre plantas que podem fazer mal pra eles."
          }
        }
      }
    },
    "We'll remind you before you go" : {
      "comment" : "Travel plan button after saving",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erinnern dich, bevor du fährst"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisaremos antes de que te vayas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On te le rappellera avant ton départ"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出発前にリマインドします"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos lembrar você antes da viagem"
          }
        }
      }
    },
    "We'll send a heads-up before frost or a heatwave hits your area." : {
      "comment" : "Settings footer for frost and heatwave alerts",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir sagen dir Bescheid, bevor Frost oder eine Hitzewelle deine Gegend erreicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisamos antes de que llegue una helada o una ola de calor a tu zona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On vous prévient avant qu'une gelée ou une canicule n'arrive chez vous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お住まいの地域に霜や猛暑が来る前にお知らせします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gente te avisa antes de uma geada ou onda de calor chegar aí."
          }
        }
      }
    },
    "We've learned %@ dries in about %lld days at your place, and we'll keep listening." : {
      "comment" : "%@ plant name, %lld days",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben gelernt, dass %1$@ bei dir in etwa %2$lld Tagen trocknet, und hören weiter hin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "We've learned %1$@ dries in about %2$lld days at your place, and we'll keep listening."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendimos que %1$@ se seca en unos %2$lld días en tu casa, y seguiremos atentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a appris que %1$@ sèche en environ %2$lld jours chez toi, et on reste à l'écoute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@はあなたのおうちで約%2$lld日で乾くとわかりました。これからも様子を見ていきます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
