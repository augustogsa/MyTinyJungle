    "A bit brighter than it needs. Watch for scorched leaves" : {
      "comment" : "Placement reason, no final period.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas heller als nötig. Achte auf verbrannte Blätter"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un poco más de luz de la que necesita. Ojo con hojas quemadas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un peu plus lumineux que nécessaire. Surveille les feuilles brûlées"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要よりちょっと明るめ。葉焼けに注意してね"
