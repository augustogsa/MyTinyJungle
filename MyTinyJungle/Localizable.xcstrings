    "Cut below the moss ball and plant it whole. The old stem will sprout again." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneid unter dem Moosballen und pflanz alles zusammen ein. Der alte Stamm treibt wieder aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta debajo de la bola de musgo y plántala entera. El tallo viejo volverá a brotar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
