    "Here's how to make more of me:\n%@\nSpring and early summer are best, in bright, indirect light." : {
      "comment" : "Plant chat: propagation. %@ = bulleted list of methods.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So machst du mehr von mir:\n%@\nFrühling und Frühsommer sind am besten, bei hellem, indirektem Licht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así puedes hacer más de mí:\n%@\nLo mejor es en primavera y principios del verano, con luz indirecta brillante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voici comment faire plus de moi :\n%@\nLe printemps et le début de l'été sont parfaits, en lumière vive indirecte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぼくの増やし方はこんな感じ：\n%@\nいちばんいいのは春から初夏。明るい間接光の場所でね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É assim que você faz mais de mim:\n%@\nPrimavera e começo do verão são a melhor época, com luz clara e indireta."
          }
        }
      }
    },
    "Here's who needs you:\n%@" : {
      "comment" : "Jungle chat: list of plants needing care follows (bulleted lines).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
