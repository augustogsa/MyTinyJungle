    "Water deeply, then wait until the soil is completely dry before the next drink." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gründlich gießen, dann warten, bis die Erde ganz trocken ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riega a fondo y luego espera a que la tierra esté totalmente seca antes del próximo riego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrose à fond, puis attends que la terre soit complètement sèche avant le prochain arrosage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "たっぷり水やりしたら、土が完全に乾くまで次のお水は待ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regue bem e espere a terra secar totalmente antes de regar de novo."
          }
        }
      }
    },
    "Water evenly around the pot with room-temperature water." : {
      "comment" : "Watering method",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gieß gleichmäßig rund um den Topf mit zimmerwarmem Wasser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riega parejo alrededor de la maceta con agua a temperatura ambiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrose tout autour du pot, avec de l'eau à température ambiante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "室温の水を、鉢のまわりにまんべんなく注ぎます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regue por igual em volta do vaso com água em temperatura ambiente."
          }
        }
      }
    },
    "Water evenly around the pot with room-temperature water. Rain or filtered water is best." : {
      "comment" : "Watering method",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gieß gleichmäßig rund um den Topf mit zimmerwarmem Wasser. Regen- oder gefiltertes Wasser ist am besten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riega parejo alrededor de la maceta con agua a temperatura ambiente. Lo mejor es agua de lluvia o filtrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrose tout autour du pot, avec de l'eau à température ambiante. L'eau de pluie ou filtrée, c'est le top."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
