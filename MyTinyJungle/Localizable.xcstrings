    "Calatheas, ferns, alocasias and orchids grew up in steamy forests. Below about 50% their edges crisp." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calatheas, Farne, Alocasien und Orchideen kommen aus dampfigen Wäldern. Unter etwa 50 % werden ihre Ränder knusprig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calateas, helechos, alocasias y orquídeas crecieron en selvas húmedas. Por debajo de 50% se les tuestan los bordes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calatheas, fougères, alocasias et orchidées ont grandi dans des forêts moites. Sous 50 % environ, leurs bords grillent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カラテア、シダ、アロカシア、ランは蒸し暑い森育ち。湿度が50%くらいを切ると、葉のふちがカリカリになります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calatheas, samambaias, alocásias e orquídeas vêm de florestas abafadas. Abaixo de uns 50% de umidade, as bordas queimam."
          }
        }
      }
    },
