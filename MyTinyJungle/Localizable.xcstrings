    "Rosemary, thyme and sage like sun and lean, gritty soil. Basil, parsley and coriander like rich, moist soil." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosmarin, Thymian und Salbei mögen Sonne und magere, körnige Erde. Basilikum, Petersilie und Koriander mögen nährstoffreiche, feuchte Erde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El romero, el tomillo y la salvia aman el sol y la tierra pobre y arenosa. La albahaca, el perejil y el cilantro, la tierra rica y húmeda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le romarin, le thym et la sauge aiment le soleil et une terre pauvre et graveleuse. Le basilic, le persil et la coriandre, une terre riche et fraîche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローズマリー、タイム、セージは日なたと、やせた粒の粗い土が好き。バジル、パセリ、パクチーは栄養たっぷりで湿り気のある土が好きです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alecrim, tomilho e sálvia gostam de sol e terra pobre e arenosa. Manjericão, salsinha e coentro gostam de terra rica e úmida."
          }
        }
      }
    },
    "Rosetta" : {
      "comment" : "Demo plant nickname; pt-BR: a cute Brazilian nickname",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosetta"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosetta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosetta"
          }
        },
        "ja" : {
