        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaust du mal in meine Abzugslöcher? Wenn Wurzeln rausgucken, brauche ich mehr Platz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Le echas un ojo a mis agujeros de drenaje? Si salen raíces, necesito más espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux jeter un œil à mes trous de drainage ? Si des racines dépassent, il me faut plus de place."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鉢底の穴をのぞいてくれる？ 根っこが出てたら、もっと広い鉢がほしいってこと。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode espiar meus furos de drenagem? Raiz saindo quer dizer que preciso de mais espaço."
          }
        }
      }
    },
