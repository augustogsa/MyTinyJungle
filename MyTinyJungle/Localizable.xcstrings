    "Plants breathe out moisture. Clustered together, they make their own little cloud." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pflanzen atmen Feuchtigkeit aus. Zusammengestellt machen sie sich ihre eigene kleine Wolke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las plantas sueltan humedad. Juntitas, hacen su propia nubecita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plantes rejettent de l'humidité. Regroupées, elles créent leur propre petit nuage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "植物は水分を吐き出しています。寄せて置くと、自分たちで小さな雲を作るんです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As plantas soltam umidade. Juntinhas, elas criam a própria nuvenzinha."
          }
        }
      }
    },
