    "Tell me where you live (Me › Settings › Where you grow) and I'll watch the weather for your outdoor plants." : {
      "comment" : "Chat: no location set. Path names must match the app's own labels (Me tab › Settings › Where you grow).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag mir, wo du wohnst (Ich › Einstellungen › Wo du gärtnerst), dann behalte ich das Wetter für deine Draußen-Pflanzen im Blick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dime dónde vives (Tú › Configuración › Dónde cultivas) y vigilo el clima para tus plantas de afuera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis-moi où tu habites (Moi › Réglages › Où tu cultives) et je surveillerai la météo pour tes plantes d'extérieur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "住んでいる場所を教えてくれたら（自分 › 設定 › 育てている場所）、外の植物のために天気を見守ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me conte onde você mora (Você › Ajustes › Onde você cultiva) e eu fico de olho no tempo pras suas plantas de fora."
          }
        }
      }
    },
    "Tell me where you live and I'll tune care to your climate." : {
      "comment" : "Climate summary when no location is set.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag mir, wo du wohnst, dann pass ich die Pflege an dein Klima an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dime dónde vives y ajusto los cuidados a tu clima."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis-moi où tu habites et j'adapterai les soins à ton climat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
