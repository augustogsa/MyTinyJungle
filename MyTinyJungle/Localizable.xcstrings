          "stringUnit": {
            "state": "translated",
            "value": "Deixe escorrer"
          }
        }
      }
    },
    "Let it drip until it stops before it goes back in its cover pot.": {
      "comment": "Care guide step instruction; warm, practical",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe pingar até parar antes de voltar para o cachepô."
