    "Tomorrow you travel. A deep, slow drink for everyone tonight, and they'll wait happily for you." : {
      "comment" : "Notification body before trip",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgen geht’s los. Heute Abend für alle einen tiefen, langsamen Schluck, dann warten sie glücklich auf dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mañana te vas de viaje. Un riego lento y profundo para todas esta noche, y te esperarán felices."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demain tu pars. Un arrosage lent et profond pour tout le monde ce soir, et elles t'attendront sagement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明日は旅行ですね。今夜みんなにゆっくりたっぷりお水をあげれば、ごきげんで待っていてくれます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amanhã você viaja. Capriche na regada de todo mundo hoje à noite, e elas vão esperar você numa boa."
          }
        }
      }
    },
