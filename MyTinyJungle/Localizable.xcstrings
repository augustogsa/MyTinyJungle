    "Skip feeding for two weeks afterwards.": {
      "comment": "Care guide step tip",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique duas semanas sem adubar depois."
          }
        }
      }
    },
    "Skip fertilizer the week before": {
      "comment": "Travel prep item",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de adubo na semana anterior"
          }
        }
      }
    },
    "Skip shine sprays and oils: they block the leaf's pores.": {
      "comment": "Care guide step instruction; warm, practical",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pule sprays e óleos de brilho: eles entopem os poros da folha."
          }
        }
      }
    },
    "Sleepy time. Less water, no food, keep them off cold glass.": {
      "comment": "Winter tip; Brazilian winter is mild/dry",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora da soneca. Menos água, nada de adubo e longe do vidro frio."
          }
        }
      }
    },
    "Slide a wooden skewer to the bottom for 10 s. Damp soil sticks to it.": {
      "comment": "Care guide step instruction; warm, practical",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfie um palito de churrasco até o fundo por 10 s. Terra úmida gruda nele."
          }
        }
      }
    },
    "Slide it out": {
      "comment": "Care guide step title; short",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire do vaso"
          }
        }
      }
    },
    "Slightly moist": {
      "comment": "Chat quick reply chip: soil state; max 14 chars\nChat suggestion chip: the soil feels slightly moist (pt: 'Levemente úmida').\nSoil moisture quick reply chip\nSoil moisture state",
