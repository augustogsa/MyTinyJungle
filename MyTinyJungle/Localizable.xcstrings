    "In 4–8 weeks roots show through the moss." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach 4–8 Wochen sieht man Wurzeln durchs Moos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En 4–8 semanas las raíces se asoman por el musgo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En 4 à 8 semaines, les racines apparaissent dans la mousse."
          }
        },
        "ja" : {
          "stringUnit" : {
