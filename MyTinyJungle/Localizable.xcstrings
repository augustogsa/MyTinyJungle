    "Heads up: I'm not safe for pets to chew. Keep me somewhere they can't reach." : {
      "comment" : "Plant speaking in chat, request safety, default voice (cheerful/any personality): warm and friendly.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtung: Ich bin nichts zum Knabbern für Haustiere. Stell mich irgendwohin, wo sie nicht rankommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso: no soy segura si una mascota me mastica. Ponme donde no lleguen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
