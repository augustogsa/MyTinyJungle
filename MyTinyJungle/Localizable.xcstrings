    "Invite the people you live with. Everyone gets reminders on their turn, sees who watered last, and can pass a plant along when life gets busy.": {
      "comment": "Shared jungle setup body",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convide quem mora com você. Cada um recebe lembretes na sua vez, vê quem regou por último e pode passar uma planta adiante quando a vida apertar."
          }
        }
      }
    },
    "Invite to %@": {
      "comment": "Invite headline; %@ jungle name",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convidar para %@"
          }
        }
      }
    },
    "Is it getting dry in here, or is it just me? Check my soil, quickly!": {
      "comment": "Plant speaking in chat, request checkSoil, dramatic personality: over-the-top drama queen, theatrical, CAPS for emphasis (pt: 'dramática', exagerada).",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá ficando seco aqui ou é impressão minha? Confere minha terra, rápido!"
          }
        }
      }
    },
    "Is it pet-safe?": {
      "comment": "Chat suggestion chip: question whether a plant is safe for pets.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É segura para pets?"
          }
        }
      }
    },
    "Is the air at home dry or damp?": {
      "comment": "Setup chat: mascot asks about indoor humidity",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ar da sua casa é seco ou úmido?"
          }
        }
      }
    },
    "Isolate": {
      "comment": "Care guide step title; short",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isole"
          }
        }
