    "Tap water minerals slowly poison them. Rain or distilled water only." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mineralien aus dem Leitungswasser vergiften sie langsam. Nur Regen- oder destilliertes Wasser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los minerales del agua de la llave las envenenan poco a poco. Solo agua de lluvia o destilada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les minéraux de l'eau du robinet les empoisonnent petit à petit. Uniquement de l'eau de pluie ou distillée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水道水のミネラルは少しずつ毒になります。雨水か蒸留水だけにしてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os minerais da água da torneira fazem mal aos poucos. Use só água da chuva ou destilada."
          }
        }
      }
    },
