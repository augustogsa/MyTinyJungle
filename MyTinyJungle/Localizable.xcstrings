    "Gentle pest remedies" : {
      "comment" : "Care guide title; short",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanfte Mittel gegen Schädlinge"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remedios suaves contra plagas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remèdes doux contre les nuisibles"
          }
        },
