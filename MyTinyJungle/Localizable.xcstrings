    "Quiet hours": {
      "comment": "Settings group title",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Horário de descanso"
          }
        }
      }
    },
    "Radiators and heaters dry the air. Keep pots a metre away.": {
      "comment": "Care guide step instruction; warm, practical",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquecedores e ar-condicionado ressecam o ar. Deixe os vasos a um metro de distância."
          }
        }
      }
    },
    "Rain washes nutrients out. A liquid feed every 1–2 weeks keeps flowers coming.": {
      "comment": "Care guide step instruction; warm, practical",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chuva lava os nutrientes. Adubo líquido a cada 1–2 semanas mantém as flores vindo."
          }
        }
      }
    },
    "Rainwater": {
      "comment": "Care guide step title; short",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Água de chuva"
          }
        }
      }
    },
    "Rainwater, sun, and no food": {
      "comment": "Care guide subtitle; short",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Água de chuva, sol e nada de comida"
          }
        }
      }
    },
    "Rainy season in %@. Plants grow fast; feed them and watch for soggy pots.": {
      "comment": "Season card. %@ = place.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estação chuvosa em %@. As plantas crescem rápido; adube e fique de olho em vaso encharcado."
          }
        }
      }
    },
    "Raise humidity: mites love dry air": {
