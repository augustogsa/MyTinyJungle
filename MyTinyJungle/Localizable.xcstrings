            "state": "translated",
            "value": "A cada 2–3 meses, ou quando aparecer uma crosta branca na terra."
          }
        }
      }
    },
    "Every bottle shows N-P-K. Nitrogen grows leaves, phosphorus supports roots, potassium helps flowers and fruit.": {
      "comment": "Care guide step instruction; warm, practical",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda embalagem traz o N-P-K. Nitrogênio faz folhas, fósforo fortalece raízes e potássio ajuda flores e frutos."
          }
        }
      }
    },
    "Every month": {
      "comment": "Care plan value",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo mês"
          }
        }
      }
    },
    "Every plant gets a place": {
      "comment": "Paywall benefit title; max 32 chars",
