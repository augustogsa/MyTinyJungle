    "Hi, I'm %@! Nice to meet you. Tell me what kind of plant I am so I can look after myself properly. %@" : {
      "comment" : "Plant chat: a newly added plant of unknown species introduces itself. Args: plant name, then the question 'When did you last water me?'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi, ich bin %1$@! Schön, dich kennenzulernen. Sag mir, was für eine Pflanze ich bin, damit ich richtig auf mich aufpassen kann. %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hi, I'm %1$@! Nice to meet you. Tell me what kind of plant I am so I can look after myself properly. %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola, soy %1$@! Mucho gusto. Dime qué tipo de planta soy para poder cuidarme bien. %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coucou, je suis %1$@ ! Ravie de te rencontrer. Dis-moi quelle plante je suis pour que je sache bien prendre soin de moi. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは、%1$@だよ！ よろしくね。ぼくが何の植物か教えてくれたら、ちゃんと自分のお世話ができるよ。%2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi, eu sou %1$@! Prazer! Me conta que tipo de planta eu sou pra eu me cuidar direitinho. %2$@"
          }
        }
      }
    },
    "Hi, I'm %@! What kind of plant am I?" : {
      "comment" : "Plant voice intro when species unknown; arg plant name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
