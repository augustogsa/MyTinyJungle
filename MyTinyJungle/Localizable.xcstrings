    "Most pests hide underneath. Look for webs, white fluff, brown bumps or tiny dots." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten Schädlinge verstecken sich unten. Achte auf Gespinste, weiße Watte, braune Höcker oder winzige Punkte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría de las plagas se esconden abajo. Busca telarañas, pelusa blanca, bultitos cafés o puntitos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart des nuisibles se cachent dessous. Cherche des toiles, du duvet blanc, des bosses brunes ou de minuscules points."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "害虫のほとんどは葉の裏に隠れています。クモの巣、白い綿、茶色いぶつぶつ、小さな点を探してね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maioria das pragas se esconde embaixo das folhas. Procure teias, um algodão branco, carocinhos marrons ou pontinhos."
          }
        }
      }
    },
    "Mothra, Phala, Orla" : {
