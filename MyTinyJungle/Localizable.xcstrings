    "This deletes your account and erases every plant, photo and care history on every device. It can't be undone. Subscriptions are managed in your Apple account." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit löschst du dein Konto und alle Pflanzen, Fotos und den Pflegeverlauf auf allen Geräten. Das lässt sich nicht rückgängig machen. Abos verwaltest du in deinem Apple-Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto borra tu cuenta y cada planta, foto e historial de cuidados en todos tus dispositivos. No se puede deshacer. Las suscripciones se administran en tu cuenta de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime ton compte et efface chaque plante, photo et historique de soins sur tous tes appareils. C'est irréversible. Les abonnements se gèrent dans ton compte Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除し、すべてのデバイスから植物、写真、お世話の記録をすべて消去します。元に戻せません。サブスクリプションはAppleアカウントで管理されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso apaga sua conta e todas as plantas, fotos e histórico de cuidados em todos os aparelhos. Não dá pra desfazer. As assinaturas ficam na sua conta Apple."
          }
        }
      }
    },
