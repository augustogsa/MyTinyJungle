        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minha terra secou. Uma rega lenta e caprichada seria uma delícia."
          }
        }
      }
    },
    "My soil is still fresh from repotting and has nutrients. Let's wait about 6 weeks before feeding." : {
