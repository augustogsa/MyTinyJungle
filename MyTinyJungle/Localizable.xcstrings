          }
        }
      }
    },
    "Our care tips come from botanists and trusted plant sources like Kew Gardens and the ASPCA. Every plant is a little different, so trust your fingers in the soil too." : {
      "comment" : "Settings footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsere Pflegetipps stammen von Botanikern und vertrauenswürdigen Quellen wie Kew Gardens und der ASPCA. Jede Pflanze ist etwas anders, also vertrau auch deinem Finger in der Erde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuestros consejos vienen de botánicos y fuentes confiables como Kew Gardens y la ASPCA. Cada planta es un poco distinta, así que confía también en tus dedos en la tierra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos conseils de soin viennent de botanistes et de sources fiables comme les jardins de Kew et l'ASPCA. Chaque plante est un peu différente, alors fais aussi confiance à tes doigts dans la terre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お世話のヒントは、植物学者やキューガーデン、ASPCAなど信頼できる情報源をもとにしています。植物はそれぞれ少しずつ違うので、土をさわった指の感覚も信じてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nossas dicas vêm de botânicos e fontes confiáveis, como o Kew Gardens e a ASPCA. Cada planta tem seu jeito, então confie também no seu dedo na terra."
          }
        }
      }
    },
