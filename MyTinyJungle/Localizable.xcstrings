    "I was last watered %@.": {
      "comment": "Plant chat. %@ = relative day like 'today', 'yesterday', '3 days ago'.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Minha última rega foi %@."
          }
        }
      }
    },
    "I'd love to meet your first plant! Try \"I have a monstera called Milo in the living room\".": {
      "comment": "Jungle chat: no plants yet; example sentence the user can type to add one (translate the example into natural Portuguese the parser understands, e.g. 'Tenho uma costela-de-adão chamada Milo na sala').",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quero muito conhecer sua primeira planta! Tente \"Tenho uma costela-de-adão chamada Milo na sala\"."
          }
        }
      }
    },
    "I'll ask for a soil check in ~%lld days": {
      "comment": "Next step after watering; %lld days (plural)",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
