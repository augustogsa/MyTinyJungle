    },
    "Thinking of you. Come say hi." : {
      "comment" : "Plant speaks up on its own in chat with a gentle care nudge. First person, warm.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich denk an dich. Komm mal Hallo sagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensando en ti. Ven a saludar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je pense à toi. Viens dire bonjour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのことを考えてたよ。会いに来てね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensando em você. Vem dar um oi."
          }
        }
      }
    },
    "Thirst, heat or dry air. Feel the soil first." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durst, Hitze oder trockene Luft. Erst die Erde fühlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sed, calor o aire seco. Toca la tierra primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soif, chaleur ou air sec. Tâte la terre d'abord."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "のどの渇き、暑さ、乾燥。まず土をさわってね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sede, calor ou ar seco. Sinta a terra primeiro."
          }
        }
      }
    },
