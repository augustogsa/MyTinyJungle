    "%@: %@ What helps: %@ Keep me apart from the others until it's clear." : {
      "comment" : "Plant chat: pest card. Args: pest name, signs sentence, fix sentence.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@ Was hilft: %3$@ Halt mich von den anderen fern, bis es vorbei ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@ What helps: %3$@ Keep me apart from the others until it's clear."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@ Qué ayuda: %3$@ Mantenme lejos de las demás hasta que se resuelva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : %2$@ Ce qui aide : %3$@ Isole-moi des autres jusqu'à ce que ce soit réglé."
          }
