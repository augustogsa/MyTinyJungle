    "Stretching and small leaves ask for more light. Bleached or crispy patches ask for less." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lang gezogene Triebe und kleine Blätter wollen mehr Licht. Ausgeblichene oder knusprige Stellen wollen weniger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se estira y saca hojas chiquitas, pide más luz. Las manchas pálidas o crujientes piden menos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des tiges qui s'étirent et des petites feuilles réclament plus de lumière. Des taches décolorées ou grillées, moins."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひょろひょろ伸びて葉が小さいなら、光をもっと。色が抜けたりカリカリなら、光を控えめに。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caules esticados e folhas pequenas pedem mais luz. Manchas desbotadas ou queimadas pedem menos."
          }
        }
      }
    },
    "Struggling" : {
      "comment" : "Plant status badge. Max 14 chars.",
