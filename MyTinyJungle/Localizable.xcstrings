                "stringUnit": {
                  "state": "translated",
                  "value": "In my current setup I usually dry in about %lld days. I learned that from your soil checks."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Do jeito que estou agora, costumo secar em uns %lld dia. Aprendi isso com os seus toques na terra."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Do jeito que estou agora, costumo secar em uns %lld dias. Aprendi isso com os seus toques na terra."
