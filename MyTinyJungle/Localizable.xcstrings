    "Wipe from stem to tip, top and underside. Check for pests while you're there." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wisch vom Stiel zur Spitze, oben und unten. Schau dabei gleich nach Schädlingen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpia del tallo a la punta, por arriba y por abajo. Aprovecha para buscar plagas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essuie de la tige à la pointe, dessus et dessous. Profites-en pour chercher des nuisibles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "茎から先端へ、表も裏も拭きます。ついでに害虫もチェック。"
