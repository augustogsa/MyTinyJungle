    "Everything your plants need, gathered into one gentle note at the time you choose. Never a flood." : {
      "comment" : "Settings footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was deine Pflanzen brauchen, in einer sanften Nachricht zu deiner Wunschzeit. Nie eine Flut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que necesitan tus plantas, juntito en una notificación suave a la hora que elijas. Nunca un montón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
