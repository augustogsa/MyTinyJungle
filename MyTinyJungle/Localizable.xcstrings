        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El aire se siente un poco seco. Una rociadita suave me haría sentir en casa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'air est un peu sec. Une petite brumisation, et je me sentirais comme chez moi."
