    "Turn off anything you'd rather handle on your own. We'll still keep an eye on it in the app." : {
      "comment" : "Settings footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte aus, was du lieber selbst im Blick hast. In der App behalten wir es trotzdem im Auge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva lo que prefieras manejar por tu cuenta. Igual lo vamos a seguir vigilando en la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactive ce que tu préfères gérer toi-même. On garde quand même un œil dessus dans l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分でやりたいものはオフにしてね。アプリではそのまま見守ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative o que preferir cuidar por conta própria. O app continua de olho."
          }
        }
      }
    },
    "Turn the pot a quarter turn in the same direction every time." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreh den Topf jedes Mal eine Vierteldrehung in dieselbe Richtung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la maceta un cuarto de vuelta, siempre en la misma dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tourne le pot d'un quart de tour, toujours dans le même sens."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎回同じ方向に、鉢を1/4回転させます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gire o vaso um quarto de volta, sempre pro mesmo lado."
