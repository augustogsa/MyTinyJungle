    "Choose a healthy stem with 1–3 leaves and at least one node (and an aerial root if it has one)." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähl einen gesunden Trieb mit 1–3 Blättern und mindestens einem Knoten (und einer Luftwurzel, falls vorhanden)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un tallo sano con 1–3 hojas y al menos un nudo (y una raíz aérea si tiene)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis une tige saine avec 1 à 3 feuilles et au moins un nœud (et une racine aérienne s'il y en a une)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "葉が1〜3枚あって、節が1つ以上ある元気な茎を選んでね（気根があればそれも）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um caule saudável com 1–3 folhas e pelo menos um nó (e uma raiz aérea, se tiver)."
          }
        }
      }
    },
    "Choose a node about 30 cm below the top. Make a small upward nick or simply find an aerial root." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Such dir einen Knoten etwa 30 cm unter der Spitze. Mach eine kleine Kerbe nach oben oder nimm einfach eine Luftwurzel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un nudo unos 30 cm debajo de la punta. Haz un cortecito hacia arriba o simplemente busca una raíz aérea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis un nœud environ 30 cm sous le sommet. Fais une petite entaille vers le haut ou trouve simplement une racine aérienne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先端から30cmくらい下の節を選びます。上向きに小さく切れ目を入れるか、気根を探すだけでもOK。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um nó uns 30 cm abaixo da ponta. Faça um pequeno corte pra cima ou aproveite uma raiz aérea."
          }
        }
      }
    },
    "Choose a plan" : {
      "comment" : "Paywall buy button",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarif wählen"
