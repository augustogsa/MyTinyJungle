    "I'm feeling quite dry. Whenever you can today, a slow drink would help me so much." : {
      "comment" : "Plant speaking, calm personality, very dry; gentle",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin ziemlich trocken. Wann immer du heute kannst: Ein langsamer Schluck würde mir so helfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me siento bastante seca. Cuando puedas hoy, un traguito despacio me ayudaría muchísimo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je me sens bien sèche. Quand tu peux aujourd'hui, un arrosage lent me ferait tellement de bien."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "けっこう乾いてきちゃった。今日どこかで、ゆっくりお水をもらえたらすごく助かるな。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tô me sentindo bem sequinha. Quando puder hoje, uma regada lenta ia me ajudar demais."
          }
        }
      }
    },
    "I'm flowering!" : {
      "comment" : "Plant thanks the user after care action 'flower'. If the line is short and dry it is the independent (terse) personality; if theatrical it is the dramatic one; otherwise warm and cheerful.",
