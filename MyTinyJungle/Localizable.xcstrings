    },
    "Mounted roots dry fast. Mist or dunk them every 2–3 days." : {
      "comment" : "Care reason for a mounted plant.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raiz de planta montada seca rápido. Borrifa ou mergulha a cada 2–3 dias."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las raíces montadas se secan rápido. Rocíalas o sumérgelas cada 2–3 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les racines montées sèchent vite. Brumise-les ou trempe-les tous les 2 à 3 jours."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgebundene Wurzeln trocknen schnell. Alle 2–3 Tage besprühen oder tauchen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "着生の根はすぐ乾くよ。2〜3日ごとに霧吹きか浸してね。"
          }
        }
      }
    },
    "Soak the moss when it feels light and crisp, then let it drain." : {
      "comment" : "Care reason for a plant in sphagnum moss.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molha o musgo quando ele estiver leve e crocante, depois deixa escorrer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remoja el musgo cuando esté ligero y crujiente, y luego deja escurrir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trempe la mousse quand elle est légère et craquante, puis laisse égoutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moos tauchen, wenn es leicht und knusprig ist, dann abtropfen lassen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水苔が軽くカサカサになったら浸して、水を切ってね。"
          }
        }
      }
    },
    "Mist lightly only if the morning condensation is gone." : {
      "comment" : "Care reason for a closed terrarium.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borrifa de leve só se a condensação da manhã tiver sumido."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rocía un poco solo si ya no hay condensación por la mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brumise légèrement seulement si la condensation du matin a disparu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur leicht sprühen, wenn das Morgenkondenswasser weg ist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝の結露がなくなっていたら、軽く霧吹きしてね。"
          }
        }
      }
    },
    "Water changed %@. Fresh water every 7–10 days keeps the roots from rotting." : {
      "comment" : "Care reason for a plant growing in water. %@ = relative day.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Água trocada %@. Água nova a cada 7–10 dias evita que as raízes apodreçam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agua cambiada %@. Agua fresca cada 7–10 días evita que se pudran las raíces."
