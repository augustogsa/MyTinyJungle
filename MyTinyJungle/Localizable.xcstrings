    "Last logged %@. If you already did it, tap Yes and I'll note it." : {
      "comment" : "Care reason under 'Did you water X?'. %@ = relative day.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Último registro %@. Se você já fez, toca em Sim que eu anoto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Último registro %@. Si ya lo hiciste, toca Sí y lo anoto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
