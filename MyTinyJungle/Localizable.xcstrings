    "Pinch flower buds on basil and coriander to keep the leaves sweet." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knips bei Basilikum und Koriander die Blütenknospen ab, dann bleiben die Blätter aromatisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita los botones de flor de la albahaca y el cilantro para que las hojas sigan dulces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pince les boutons floraux du basilic et de la coriandre pour garder des feuilles bien douces."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バジルやパクチーは花芽を摘むと、葉がやわらかくおいしいままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire os botões de flor do manjericão e do coentro pras folhas continuarem saborosas."
          }
        }
      }
    },
    "Pinch just above a pair of leaves. Two new shoots will grow there." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knips knapp über einem Blattpaar ab. Dort wachsen zwei neue Triebe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pellizca justo arriba de un par de hojas. Ahí van a salir dos brotes nuevos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pince juste au-dessus d'une paire de feuilles. Deux nouvelles pousses partiront de là."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2枚の葉のすぐ上で摘みます。そこから新しい芽が2本伸びます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belisque logo acima de um par de folhas. Ali vão nascer dois brotos novos."
