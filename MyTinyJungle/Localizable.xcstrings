    "Mix at half the dose on the label. Houseplants prefer little and often." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misch nur die halbe Dosis vom Etikett an. Zimmerpflanzen mögen wenig und oft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezcla a la mitad de la dosis de la etiqueta. Las plantas de interior prefieren poquito y seguido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dose à la moitié de l'étiquette. Les plantes d'intérieur préfèrent peu mais souvent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ラベルの半量で混ぜてね。観葉植物は少しずつこまめにが好きです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use metade da dose do rótulo. Planta de casa prefere pouco e com frequência."
          }
        }
      }
    },
    "Mixing in ~30% perlite or bark would fix it." : {
      "comment" : "Product scan verdict reason for one plant. Args are plant or species names, numbers.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa 30 % Perlite oder Rinde untermischen würde das lösen."
