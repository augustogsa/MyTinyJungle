    "Perfect for plant-sitting. They see exactly what each plant needs." : {
      "comment" : "Invite blurb, friends",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfekt zum Pflanzensitten. Sie sehen genau, was jede Pflanze braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfecto para cuidar plantas ajenas. Ven exactamente lo que necesita cada una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parfait pour garder des plantes. Ils voient exactement ce dont chaque plante a besoin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お留守番ケアにぴったり。植物ごとに必要なことがちゃんとわかります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfeito pra quem cuida enquanto você viaja. Dá pra ver direitinho o que cada planta precisa."
          }
        }
      }
    },
    "Perlite or pumice" : {
      "comment" : "Tool needed for a care guide",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlite oder Bims"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlita o piedra pómez"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlite ou pierre ponce"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パーライトか軽石"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlita ou pedra-pomes"
          }
        }
      }
    },
    "Perlite, pumice or bark make pockets of air. Roots breathe there, and that's what keeps rot away." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlite, Bims oder Rinde schaffen Lufttaschen. Dort atmen die Wurzeln, und das hält Fäulnis fern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La perlita, la piedra pómez o la corteza crean bolsitas de aire. Ahí respiran las raíces, y eso evita que se pudran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La perlite, la pierre ponce ou l'écorce créent des poches d'air. Les racines y respirent, et c'est ce qui éloigne la pourriture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パーライト、軽石、バークは空気のすき間を作ります。根はそこで呼吸できて、根腐れを防げます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlita, pedra-pomes ou casca de pinus criam bolsões de ar. As raízes respiram ali, e é isso que afasta o apodrecimento."
          }
        }
      }
    },
