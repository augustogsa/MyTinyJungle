    "%@ is stressed. Fix the water and light first, since repotting adds stress." : {
      "comment" : "Repot verdict explanation; arg plant name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist gestresst. Kümmer dich erst um Wasser und Licht, Umtopfen stresst zusätzlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está estresada. Primero arregla el agua y la luz, porque trasplantar la estresa más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est stressée. Règle d'abord l'eau et la lumière, un rempotage ajouterait du stress."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
