    "Soggy soil risks root rot. Fresh, airy mix now, even in winter." : {
      "comment" : "Repot verdict explanation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matschige Erde riskiert Wurzelfäule. Jetzt frische, luftige Erde, auch im Winter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tierra empapada arriesga pudrir las raíces. Mezcla nueva y aireada ya, incluso en invierno."
