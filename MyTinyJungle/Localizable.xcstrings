    "Less sun means slower drying. A metre back makes a real difference." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger Sonne heißt langsameres Trocknen. Ein Meter weiter weg macht echt was aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos sol significa que se seca más lento. Un metro más atrás hace una gran diferencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins de soleil, ça sèche moins vite. Un mètre de recul fait une vraie différence."
