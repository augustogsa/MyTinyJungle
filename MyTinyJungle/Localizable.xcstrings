    "Soak deeply, drain fully, then leave it dry. Never leave it sitting in water." : {
      "comment" : "Watering method",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gründlich durchtränken, ganz abtropfen lassen, dann trocken lassen. Nie im Wasser stehen lassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riega a fondo, deja que escurra toda y luego déjala secar. Nunca la dejes parada en agua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrose à fond, égoutte bien, puis laisse sécher. Ne la laisse jamais tremper dans l'eau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "たっぷり浸して、しっかり水を切り、あとは乾かします。水につけっぱなしはNG。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regue bem, deixe escorrer tudo e espere secar. Nunca deixe água parada no pratinho."
          }
        }
      }
    },
    "Soak from below" : {
