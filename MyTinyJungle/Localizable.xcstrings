        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ e o resto da família agradecem. Estufa e Selva têm tudo pra deixar todas felizes."
          }
        }
      }
    },
    "%@, %@ and the rest of the family would love some company. Greenhouse and Jungle make room for all of them." : {
      "comment" : "Paywall subline; args are two plant names",
      "localizations" : {
        "de" : {
          "stringUnit" : {
