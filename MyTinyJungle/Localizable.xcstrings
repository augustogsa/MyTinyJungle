        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em 4–8 semanas as raízes aparecem pelo musgo."
          }
        }
      }
    },
    "In a few weeks, a baby plant forms at the base. Let the old leaf shrivel by itself." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In ein paar Wochen bildet sich am Ansatz ein Pflanzenbaby. Lass das alte Blatt von selbst vertrocknen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En unas semanas se forma una plantita bebé en la base. Deja que la hoja vieja se seque sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En quelques semaines, un bébé se forme à la base. Laisse la vieille feuille se flétrir toute seule."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数週間で根元に赤ちゃん株ができます。元の葉は自然にしぼむまで放っておいてね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em algumas semanas, nasce uma muda na base. Deixe a folha velha secar sozinha."
          }
        }
      }
    },
