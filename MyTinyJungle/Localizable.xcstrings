    "Is it getting dry in here, or is it just me? Check my soil, quickly!" : {
      "comment" : "Plant speaking in chat, request checkSoil, dramatic personality: over-the-top drama queen, theatrical, CAPS for emphasis (pt: 'dramática', exagerada).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird’s hier trocken, oder bin das nur ich? Prüf schnell meine Erde!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se está secando todo aquí o soy yo? ¡Revisa mi tierra, rápido!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est moi ou ça sèche, ici ? Vérifie ma terre, vite !"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここ乾いてきた？ それともぼくだけ？ 早く土をチェックして！"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá ficando seco aqui ou é impressão minha? Confere minha terra, rápido!"
          }
        }
      }
    },
