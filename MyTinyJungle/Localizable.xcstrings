    "Water %@ early in the morning and give them some afternoon shade. Pots dry out fast now." : {
      "comment" : "Weather alert detail. %@ = plant names list.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gieß %@ frühmorgens und gib ihnen nachmittags etwas Schatten. Töpfe trocknen jetzt schnell aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riega a %@ temprano en la mañana y dales algo de sombra en la tarde. Ahora las macetas se secan rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrose %@ tôt le matin et donne-leur un peu d'ombre l'après-midi. Les pots sèchent vite en ce moment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@には朝早くお水をあげて、午後は日陰にしてあげてね。今は鉢がすぐ乾きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regue %@ bem cedo e dê sombra à tarde. Os vasos estão secando rápido."
          }
        }
      }
    },
