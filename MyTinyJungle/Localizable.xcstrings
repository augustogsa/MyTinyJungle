    "Plants you already have stay on your iPhone. You can be invited again anytime." : {
      "comment" : "Leave explanation",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pflanzen, die du schon hast, bleiben auf deinem iPhone. Du kannst jederzeit wieder eingeladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las plantas que ya tienes se quedan en tu iPhone. Te pueden volver a invitar cuando quieran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plantes que tu as déjà restent sur ton iPhone. Tu peux être réinvité quand tu veux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに持っている植物はiPhoneに残ります。またいつでも招待してもらえます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As plantas que você já tem ficam no seu iPhone. Dá pra ser convidado de novo quando quiser."
          }
        }
      }
    },
    "Plastic" : {
      "comment" : "Pot material",
      "localizations" : {
