    },
    "I'm comfortable between %@ and %@. Keep me away from radiators, AC vents and cold drafts." : {
      "comment" : "Plant chat: temperature range. Args: formatted min and max temperatures. In Brazil: 'aquecedor', 'ar-condicionado', 'correntes de ar frio'.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich fühl mich zwischen %1$@ und %2$@ wohl. Halt mich fern von Heizung, Klimaanlage und kalter Zugluft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I'm comfortable between %1$@ and %2$@. Keep me away from radiators, AC vents and cold drafts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estoy a gusto entre %1$@ y %2$@. Mantenme lejos de calefactores, salidas de aire acondicionado y corrientes frías."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je suis bien entre %1$@ et %2$@. Éloigne-moi des radiateurs, des bouches de clim et des courants d'air froid."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@〜%2$@がちょうどいいな。暖房器具、エアコンの風、冷たいすきま風からは離してね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fico confortável entre %1$@ e %2$@. Me deixa longe de aquecedor, saída de ar-condicionado e vento frio."
          }
        }
      }
    },
    "I'm doing great today!" : {
      "comment" : "Plant chat greeting when all is well, cheerful personality: upbeat and sunny.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
