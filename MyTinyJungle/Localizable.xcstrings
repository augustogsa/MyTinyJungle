    "Let the soil dry on top before the next drink, and make sure the pot drains." : {
      "comment" : "Photo diagnosis advice: overwatering, plant likes moist soil.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Erde oben abtrocknen vor dem nächsten Schluck und sorg dafür, dass der Topf abläuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que la tierra se seque arriba antes del próximo riego y asegúrate de que la maceta drene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse sécher le dessus de la terre avant le prochain arrosage, et vérifie que le pot draine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のお水の前に表面の土を乾かして、鉢の水はけも確認してね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe a superfície da terra secar antes da próxima rega e confira se o vaso drena bem."
          }
        }
      }
    },
    "Let the soil dry well down before the next drink, and make sure the pot drains." : {
      "comment" : "Photo diagnosis advice: overwatering.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Erde gut tief abtrocknen vor dem nächsten Schluck und sorg dafür, dass der Topf abläuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que la tierra se seque bien hacia abajo antes del próximo riego y asegúrate de que la maceta drene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse bien sécher la terre en profondeur avant le prochain arrosage, et vérifie que le pot draine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のお水の前に土を深くまでしっかり乾かして、鉢の水はけも確認してね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe a terra secar bem fundo antes da próxima rega e confira se o vaso drena bem."
          }
        }
      }
    },
    "Let the top soil dry out well: larvae need wet soil" : {
      "comment" : "Pest treatment step; imperative, short; max 70 chars",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
