    "Give every plant the love it deserves" : {
      "comment" : "Paywall headline",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib jeder Pflanze die Liebe, die sie verdient"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale a cada planta el cariño que merece"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donne à chaque plante l'amour qu'elle mérite"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての植物に、ふさわしい愛情を"
