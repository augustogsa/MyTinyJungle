    "%@. Keep me out of reach. If a pet chews me and shows symptoms, call a vet." : {
      "comment" : "Plant chat: plant is toxic. %@ = toxicity sentence without final period.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Stell mich außer Reichweite. Wenn ein Haustier an mir knabbert und Symptome zeigt, ruf den Tierarzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Mantenme fuera de su alcance. Si una mascota me mastica y tiene síntomas, llama al veterinario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Garde-moi hors de portée. Si un animal me mâchouille et a des symptômes, appelle un véto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。ぼくは手の届かないところに置いてね。ペットがかじって様子がおかしかったら、獣医さんに相談してね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Me deixe fora do alcance. Se um pet me morder e tiver sintomas, ligue pro veterinário."
          }
        }
      }
    },
