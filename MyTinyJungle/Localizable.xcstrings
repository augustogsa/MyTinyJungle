    "My pot is %lld cm, so the next one should be about %lld–%lld cm." : {
      "comment" : "Plant chat: next pot size. Args: current pot diameter, min and max next diameter (cm).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mein Topf hat %1$lld cm, der nächste sollte also etwa %2$lld–%3$lld cm haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "My pot is %1$lld cm, so the next one should be about %2$lld–%3$lld cm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi maceta mide %1$lld cm, así que la siguiente debería medir unos %2$lld–%3$lld cm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mon pot fait %1$lld cm, le prochain devrait faire environ %2$lld à %3$lld cm."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぼくの鉢は%1$lldcmだから、次は%2$lld〜%3$lldcmくらいがいいな。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meu vaso tem %1$lld cm, então o próximo precisa ter uns %2$lld–%3$lld cm."
          }
        }
      }
    },
    "My roots are getting snug. Maybe a roomier pot soon?" : {
      "comment" : "Plant speaks up on its own in chat with a gentle care nudge. First person, warm.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Wurzeln werden eng. Vielleicht bald ein größerer Topf?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mis raíces ya están apretaditas. ¿Una maceta más amplia pronto?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mes racines sont un peu à l'étroit. Un pot plus spacieux bientôt ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根っこが窮屈になってきた。そろそろ広い鉢がいいかな？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minhas raízes estão apertadinhas. Que tal um vaso maior logo?"
          }
        }
      }
    },
    "My roots like a little breathing room between drinks. Feel me first?" : {
      "comment" : "Plant speaks up on its own in chat: overwatered. Gentle, first person.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Wurzeln mögen zwischen den Schlucken etwas Luft. Erst fühlen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mis raíces les gusta respirar un poco entre riegos. ¿Me tocas primero?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mes racines aiment respirer un peu entre deux arrosages. Tu me tâtes d'abord ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぼくの根っこは、お水の合間にちょっと息をつきたいんだ。先にさわってくれる？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minhas raízes gostam de respirar entre uma rega e outra. Me sente antes, tá?"
          }
        }
      }
    },
    "My roots might be getting crowded. Can we check whether I need a bigger home?" : {
      "comment" : "Plant speaking in chat, request checkRoots, default voice (cheerful/any personality): warm and friendly.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Wurzeln werden vielleicht eng. Schauen wir, ob ich ein größeres Zuhause brauche?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que mis raíces estén apretadas. ¿Revisamos si necesito una casa más grande?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mes racines sont peut-être à l'étroit. On vérifie s'il me faut une plus grande maison ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根っこが混み合ってきたかも。大きなおうちが必要か見てくれる？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minhas raízes podem estar apertadas. Vamos ver se preciso de uma casa maior?"
          }
        }
      }
    },
    "My soil is dry and it's time for a drink." : {
      "comment" : "Water sheet, plant voice",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Erde ist trocken, Zeit für einen Schluck."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi tierra está seca y es hora de un traguito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma terre est sèche, c'est l'heure de boire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "土が乾いたよ。お水の時間だ。"
          }
