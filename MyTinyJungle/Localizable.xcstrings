      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seca? Então sim, eu adoraria uma regadinha. Regue devagar até escorrer por baixo."
          }
        }
      }
    },
    "Dust": {
