    },
    "Could I have fresh water? Rinse my glass too, if you've got a minute." : {
      "comment" : "Plant speaking in chat, first person, plant growing in a glass of water asks for fresh water, warm.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me dá uma água nova? Se der, lava meu vidro também."
