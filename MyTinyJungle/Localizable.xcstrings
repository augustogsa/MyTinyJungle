    "Push a finger 2–3 cm into the soil. Dry? Water. Still cool and damp? Wait a day or two.": {
      "comment": "Care guide step instruction; warm, practical",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfie o dedo 2–3 cm na terra. Seca? Regue. Ainda fresca e úmida? Espere um ou dois dias."
          }
        }
      }
    },
    "Push one finger in near the edge of the pot, away from the stem.": {
      "comment": "Care guide step instruction; warm, practical",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfie um dedo perto da borda do vaso, longe do caule."
          }
        }
      }
    },
    "Put fresh mix at the bottom so the plant sits at the same depth": {
      "comment": "Repotting step; imperative; max 70 chars",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque substrato novo no fundo para a planta ficar na mesma altura"
          }
        }
      }
    },
    "Put it in a jar so the node is under water but the leaves stay dry.": {
      "comment": "Care guide step instruction; warm, practical",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque num pote com o nó debaixo d'água e as folhas secas."
          }
        }
      }
    },
    "Put the node under water, leaves above. Bright, indirect light.": {
      "comment": "Care guide step instruction; warm, practical",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o nó debaixo d'água e as folhas para fora. Luz clara e indireta."
          }
        }
      }
    },
