    "%@ Always water first. Never feed dry roots. Scan any bottle at the shop and I'll tell you if it suits me." : {
      "comment" : "Plant chat: feeding advice. %@ = species feeding plan sentence.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Immer erst gießen. Nie auf trockene Wurzeln düngen. Scann im Laden einfach jede Flasche, dann sag ich dir, ob sie zu mir passt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Siempre riega primero. Nunca abones con las raíces secas. Escanea cualquier frasco en la tienda y te digo si me sirve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Arrose toujours avant. Jamais d'engrais sur des racines sèches. Scanne n'importe quelle bouteille en jardinerie et je te dirai si ça me convient."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ まずはお水が先。乾いた根っこに肥料はNGだよ。お店でボトルをスキャンしてくれたら、ぼくに合うか教えるね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Regue sempre antes. Nunca adube raiz seca. Escaneie qualquer frasco na loja que eu te digo se combina comigo."
          }
        }
      }
    },
