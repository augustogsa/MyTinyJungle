    "Skip feeding for two weeks afterwards." : {
      "comment" : "Care guide step tip",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danach zwei Wochen nicht düngen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No abones durante las dos semanas siguientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saute l'engrais pendant deux semaines après."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのあと2週間は肥料をお休み。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique duas semanas sem adubar depois."
          }
        }
      }
    },
    "Skip fertilizer the week before" : {
      "comment" : "Travel prep item",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Woche davor nicht düngen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No abones la semana anterior"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d'engrais la semaine d'avant"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前の週は肥料をお休み"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem adubo na semana anterior"
          }
        }
      }
    },
    "Skip shine sprays and oils: they block the leaf's pores." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Glanzsprays und Öle weg: Die verstopfen die Poren der Blätter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvídate de los abrillantadores y aceites: tapan los poros de la hoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oublie les lustrants et les huiles : ils bouchent les pores des feuilles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "つや出しスプレーやオイルはNG：葉の気孔をふさいでしまいます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite sprays e óleos de brilho: eles entopem os poros da folha."
          }
        }
      }
    },
    "Sleepy time. Less water, no food, keep them off cold glass." : {
      "comment" : "Winter tip; Brazilian winter is mild/dry",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlafenszeit. Weniger Wasser, kein Futter, weg vom kalten Glas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hora de dormir. Menos agua, nada de comida y lejos del vidrio frío."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'heure de la sieste. Moins d'eau, pas d'engrais, et loin des vitres froides."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おやすみの季節。水は少なめ、肥料なし、冷たい窓ガラスから離してね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hora de descansar. Menos água, nada de adubo e longe do vidro frio."
          }
        }
      }
    },
    "Slide a wooden skewer to the bottom for 10 s. Damp soil sticks to it." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steck einen Holzspieß 10 Sek. bis zum Boden. Feuchte Erde bleibt daran kleben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mete un palito de madera hasta el fondo por 10 s. La tierra húmeda se le pega."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfonce une pique en bois jusqu'au fond pendant 10 s. La terre humide s'y colle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "竹串を底まで差して10秒待ちます。土が湿っていればくっついてきます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfie um palito de churrasco até o fundo por 10 s. Terra úmida gruda nele."
          }
        }
      }
    },
    "Slide it out" : {
      "comment" : "Care guide step title; short",
      "localizations" : {
