    "Leafy plants like a balanced feed. Flowering and fruiting plants like more potassium. Cacti want little nitrogen." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blattpflanzen mögen Volldünger. Blühende und fruchtende Pflanzen mögen mehr Kalium. Kakteen wollen wenig Stickstoff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las plantas de hoja quieren abono balanceado. Las que dan flor y fruto, más potasio. Los cactus, poco nitrógeno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plantes vertes aiment un engrais équilibré. Celles à fleurs et à fruits veulent plus de potassium. Les cactus, peu d'azote."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "葉ものはバランス型の肥料が好き。花や実をつける植物はカリ多め。サボテンはチッソ少なめがいいです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folhagens gostam de adubo equilibrado. Plantas com flor ou fruto pedem mais potássio. Cactos querem pouco nitrogênio."
          }
        }
      }
    },
