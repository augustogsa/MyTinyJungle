    "Stand the pot in a few centimetres of water for 20–30 minutes so dry soil can drink again." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell den Topf 20–30 Minuten ein paar Zentimeter tief ins Wasser, damit trockene Erde wieder trinken kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon la maceta en unos centímetros de agua por 20–30 minutos para que la tierra seca vuelva a beber."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose le pot dans quelques centimètres d'eau pendant 20 à 30 minutes pour que la terre sèche puisse à nouveau boire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
