    "Topped up %@. Keep the reservoir about a third of the pot deep, with hydro nutrients." : {
      "comment" : "Care reason for LECA or pon. %@ = relative day.",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completado %@. Mantém o reservatório em mais ou menos um terço do vaso, com nutriente hidropônico."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rellenado %@. Mantén el depósito en un tercio de la maceta, con nutrientes hidropónicos."
