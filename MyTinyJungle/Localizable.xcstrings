    "Copy the name, NPK numbers or ingredients. For example: Orchid mix, pine bark, perlite, NPK 3-1-1.": {
      "comment": "Type label hint",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie o nome, os números NPK ou os ingredientes. Por exemplo: substrato pra orquídea, casca de pinus, perlita, NPK 3-1-1."
          }
        }
      }
    },
