    "%@ joined. Turns are now shared fairly.": {
      "comment": "Notification: new member joined the shared jungle; %@ name",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entrou. Agora a vez é dividida de forma justa."
          }
