    "Turns go to whoever didn't do it last, keeping things fair across the month." : {
      "comment" : "Hub footer explaining turn logic",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dran ist, wer es zuletzt nicht gemacht hat, damit es übers Monat fair bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le toca a quien no lo hizo la última vez, así todo queda parejo en el mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tours vont à celui qui ne l'a pas fait la dernière fois, pour rester équitable sur le mois."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回やらなかった人に順番がまわるので、1か月を通して公平です。"
