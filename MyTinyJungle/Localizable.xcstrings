    "Sign in from Settings to invite people. Your shared jungle is ready the moment you do." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich in den Einstellungen an, um Leute einzuladen. Dein geteilter Dschungel ist sofort bereit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión desde Configuración para invitar personas. Tu selva compartida estará lista en cuanto lo hagas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte-toi dans Réglages pour inviter des gens. Ta jungle partagée est prête dès que c'est fait."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」からサインインするとメンバーを招待できます。サインインすればすぐにシェアジャングルの準備完了です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra na sua conta pelos Ajustes pra convidar gente. Sua selva compartilhada fica pronta na hora."
          }
        }
      }
    },
    "Sign in from Settings to join this jungle. The invite will be waiting." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich in den Einstellungen an, um diesem Dschungel beizutreten. Die Einladung wartet auf dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión desde Configuración para unirte a esta selva. La invitación te va a esperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte-toi dans Réglages pour rejoindre cette jungle. L'invitation t'attendra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」からサインインして、このジャングルに参加してね。招待はそのまま待っています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra na sua conta pelos Ajustes pra participar dessa selva. O convite fica te esperando."
          }
        }
      }
    },
