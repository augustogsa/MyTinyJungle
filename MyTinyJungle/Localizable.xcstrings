    "I'm great! Nice light, happy roots. Did you see my leaves?" : {
      "comment" : "Plant chat greeting when all is well, chatty personality: bubbly, talkative, excited.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mir geht’s super! Schönes Licht, glückliche Wurzeln. Hast du meine Blätter gesehen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Estoy genial! Buena luz, raíces felices. ¿Viste mis hojas?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça va super ! Belle lumière, racines heureuses. Tu as vu mes feuilles ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高だよ！ 光もいい感じで、根っこもごきげん。ぼくの葉っぱ見た？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tô ótima! Luz boa, raízes felizes. Viu minhas folhas?"
          }
        }
      }
    },
    "I'm growing and a bit hungry. A diluted feed with my next drink?" : {
      "comment" : "Plant speaking in chat, request feed, default voice (cheerful/any personality): warm and friendly.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich wachse und hab ein bisschen Hunger. Verdünnter Dünger beim nächsten Gießen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estoy creciendo y tengo un poquito de hambre. ¿Un abono diluido con mi próximo riego?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je pousse et j'ai un petit creux. Un engrais dilué avec mon prochain arrosage ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成長中でちょっとおなかが空いたな。次のお水に薄めた肥料を混ぜてくれる？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tô crescendo e com uma fominha. Um adubo diluído na próxima rega?"
          }
        }
      }
    },
    "I'm growing really well! I just pushed a new leaf." : {
      "comment" : "Plant voice, first person, proud and happy",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich wachse richtig gut! Gerade kam ein neues Blatt."
          }
        },
        "es" : {
