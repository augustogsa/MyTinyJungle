    "Always feel the soil first. The calendar is only a guess." : {
      "comment" : "Plant chat: watering advice closer.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fühl immer erst die Erde. Der Kalender ist nur eine Schätzung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre toca la tierra primero. El calendario es solo un cálculo."
          }
