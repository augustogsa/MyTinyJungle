    "Light fades fast. Two metres from a window can be a quarter of the light right beside it." : {
      "comment" : "Care guide step instruction; warm, practical",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licht nimmt schnell ab. Zwei Meter vom Fenster entfernt ist oft nur ein Viertel so viel Licht wie direkt daneben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luz baja rápido. A dos metros de una ventana puede haber un cuarto de la luz que hay justo al lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lumière baisse vite. À deux mètres d'une fenêtre, il peut n'y avoir qu'un quart de la lumière d'à côté."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光はすぐ弱まります。窓から2m離れると、窓辺の1/4くらいの明るさになることも。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A luz cai rápido. A dois metros da janela pode ter só um quarto da luz que bate ali do lado."
          }
        }
      }
    },
